// ---------- theme: dark mode ----------
function applyTheme(){
  const dark = store.get("theme","light")==="dark";
  document.body.classList.toggle("dark", dark);
  const b = $("themeBtn"); if(b) b.textContent = dark ? "☀️" : "🌙";
}

// ---------- daily activity log ----------
function logDay(kind){ // 'n' = new word, 'r' = review
  try{
    const k="englab_daily", d=localDay(0);
    const o=JSON.parse(localStorage.getItem(k)||"{}");
    o[d]=o[d]||{n:0,r:0}; o[d][kind]=(o[d][kind]||0)+1;
    const ks=Object.keys(o).sort();
    while(ks.length>90) delete o[ks.shift()];
    localStorage.setItem(k,JSON.stringify(o));
  }catch(e){}
}

// ---------- shared filtered word list ----------
function currentList(){
  let vs = vocab.slice();
  if(cefrFilter!=="ALL") vs = vs.filter(v=>(cefrOf(v.w)||"?")===cefrFilter);
  if(examFilter!=="ALL") vs = vs.filter(v=>examOf(v.w).includes(examFilter));
  const sort = $("cefrSort").value;
  if(sort==="asc") vs.sort((a,b)=>((CEFR_ORDER[cefrOf(a.w)]??99)-(CEFR_ORDER[cefrOf(b.w)]??99)));
  else if(sort==="desc") vs.sort((a,b)=>((CEFR_ORDER[cefrOf(b.w)]??-1)-(CEFR_ORDER[cefrOf(a.w)]??-1)));
  return vs;
}

// ---------- 1. passive listening playlist ----------
let playAbort=false;
function stopPlayer(){ try{ $("player").pause(); }catch(e){} try{ speechSynthesis.cancel(); }catch(e){} }
async function playAllList(){
  const vs=currentList();
  if(!vs.length){ toast("No words in this filter"); return; }
  playAbort=false;
  $("playAll").style.display="none"; $("playStop").style.display="";
  for(const v of vs){
    if(playAbort) break;
    $("nowPlaying").textContent="🔊 "+v.w;
    try{ await speak(v.w); }catch(e){}
    if(playAbort) break;
    await new Promise(r=>setTimeout(r,600));
    if(v.m && !playAbort){
      $("nowPlaying").textContent="💬 "+v.m;
      try{ await speak(v.m); }catch(e){}
      await new Promise(r=>setTimeout(r,800));
    }
  }
  stopPlaylistUI();
  recordStudy();
}
function stopPlaylistUI(){
  $("nowPlaying").textContent="";
  $("playAll").style.display=""; $("playStop").style.display="none";
}

// ---------- 4. word of the day ----------
function currentLevel(){
  for(const [lv] of PATH_LEVELS){ if(vocab.some(v=>(cefrOf(v.w)||"?")===lv && v.box<3)) return lv; }
  return "A1";
}
function wordOfDay(){
  const lv=currentLevel();
  const arr=(CEFR_LV[lv]||"").split("|").filter(Boolean);
  if(!arr.length) return {w:"hello", lv};
  return {w:arr[Math.floor(Date.now()/864e5)%arr.length], lv};
}
function renderWod(){
  const box=$("wodBody"); if(!box) return;
  const {w,lv}=wordOfDay();
  box.innerHTML=`<div class="wod-word">${esc(w)} <span class="cefr" style="background:${CEFR_COLORS[lv]}">${lv}</span></div>
    <div class="row" style="margin-top:10px;flex-wrap:wrap">
      <button class="btn primary" id="wodHear">🔊 Hear it</button>
      <button class="btn ghost" id="wodAdd">＋ Add to vocab</button>
      <button class="btn ghost" id="wodDict">📖 Define</button>
    </div>`;
  $("wodHear").onclick=()=>safeSpeak(w);
  $("wodDict").onclick=()=>openDict(w);
  $("wodAdd").onclick=()=>{
    if(vocab.some(v=>v.w.toLowerCase()===w.toLowerCase())){ toast("Already in your vocab"); return; }
    vocab.unshift({id:Date.now(),w,m:"",ex:"",box:1,last:0});
    saveVocab(); renderVocab(); logDay('n'); toast("Added: "+w);
  };
}
async function enableDailyWord(){
  if(!("Notification" in window)){ toast("This device has no notifications — your word is still here every day 📅"); return; }
  try{
    const p=await Notification.requestPermission();
    if(p==="granted"){ store.set("notifyWord","1"); toast("Daily word reminder ON 🔔"); maybeNotifyWord(true); }
    else toast("Notifications blocked — allow them in browser settings");
  }catch(e){ toast("Cannot enable notifications"); }
}
function maybeNotifyWord(force){
  try{
    if(store.get("notifyWord")!=="1") return;
    if(!("Notification" in window) || Notification.permission!=="granted") return;
    const today=localDay(0);
    if(!force && store.get("notifyWordDate")===today) return;
    store.set("notifyWordDate",today);
    const {w,lv}=wordOfDay();
    new Notification("📚 Word of the day ("+lv+")",{body:w+" — open English Lab to hear it"});
  }catch(e){}
}

// ---------- 5. progress stats ----------
function renderStats(){
  const box=$("statBars"); if(!box) return;
  let o={}; try{ o=JSON.parse(localStorage.getItem("englab_daily")||"{}"); }catch(e){}
  const days=[]; for(let i=6;i>=0;i--) days.push(localDay(-i));
  const vals=days.map(d=>((o[d]||{}).n||0)+((o[d]||{}).r||0));
  const max=Math.max(1,...vals), wd=["S","M","T","W","T","F","S"];
  box.innerHTML=days.map((d,i)=>{
    const v=vals[i], h=Math.max(8,Math.round(v/max*100));
    return `<div class="stat-bar" style="height:${h}%" title="${d}: ${v}"><span>${wd[new Date(d+"T12:00:00").getDay()]}</span></div>`;
  }).join("");
  const total=vocab.length, mastered=vocab.filter(v=>v.box>=3).length;
  $("statLine").textContent=`${total} words total · ${mastered} mastered · ${vals.reduce((a,b)=>a+b,0)} activities this week`;
}

// ---------- 7. exam countdown / cram mode ----------
function renderCram(){
  const out=$("cramOut"); if(!out) return;
  const lv=store.get("cramLevel",""), dt=store.get("cramDate","");
  if($("cramLevel") && !$("cramLevel").value && lv) $("cramLevel").value=lv;
  if($("cramDate") && !$("cramDate").value && dt) $("cramDate").value=dt;
  if(!lv||!dt){ out.textContent="Set a target level and exam date."; return; }
  const days=Math.ceil((new Date(dt+"T00:00:00")-new Date(localDay(0)+"T00:00:00"))/864e5);
  if(days<=0){ out.textContent="⚠️ Exam date has passed — set a new goal."; return; }
  const order=["A1","A2","B1","B2","C1","C2"], li=order.indexOf(lv);
  let remaining=0;
  for(let i=0;i<=li;i++){
    const L=order[i];
    const inDb=(CEFR_LV[L]||"").split("|").filter(Boolean).length;
    const have=new Set(vocab.filter(v=>(cefrOf(v.w)||"?")===L).map(v=>v.w.toLowerCase()));
    remaining+=Math.max(0,inDb-have.size);
  }
  out.innerHTML=`📅 <b>${Math.ceil(remaining/days).toLocaleString()} words/day</b> to reach <b>${lv}</b> by ${dt} <span style="color:var(--muted)">(${days} days left · ${remaining.toLocaleString()} words to go)</span>`;
}

// ---------- 3. dialogue roleplay ----------
let rpIdx=0, rpTurns=[];
function rpStart(){
  if(sents.length<2){ toast("Add at least 2 sentences to the bank first"); return; }
  rpTurns=sents.slice(0,6).map(s=>s.t); rpIdx=0;
  $("rpArea").innerHTML=""; rpRender();
}
function rpRender(){
  const area=$("rpArea");
  if(rpIdx>=rpTurns.length){
    area.insertAdjacentHTML("beforeend",`<div class="rp-done">🎉 Dialogue complete! Nice work.</div>`);
    recordStudy(); return;
  }
  const t=rpTurns[rpIdx], mine=rpIdx%2===1;
  const d=document.createElement("div");
  d.className="rp-turn "+(mine?"me":"app");
  d.innerHTML=`<div class="rp-role">${mine?"🙋 You (B)":"🤖 App (A)"}</div><div class="rp-text">${esc(t)}</div><div class="rp-ctl"></div><div class="rp-score"></div>`;
  area.appendChild(d); d.scrollIntoView({block:"nearest",behavior:"smooth"});
  const ctl=d.querySelector(".rp-ctl");
  const nb=document.createElement("button");
  nb.className="btn ghost"; nb.textContent="Next →";
  nb.onclick=()=>{ rpIdx++; rpRender(); };
  if(!mine){
    const pb=document.createElement("button"); pb.className="btn primary"; pb.textContent="🔊 Play";
    pb.onclick=()=>safeSpeak(t);
    ctl.append(pb,nb); safeSpeak(t);
  }else if(window.SpeechRecognition||window.webkitSpeechRecognition){
    const sb=document.createElement("button"); sb.className="btn green"; sb.textContent="🎙️ Say it";
    sb.onclick=()=>rpListen(t,d,()=>ctl.append(nb));
    ctl.append(sb);
  }else{
    d.querySelector(".rp-score").innerHTML=`<div class="hint">Read it aloud, then continue →</div>`;
    ctl.append(nb);
  }
}
function rpListen(expected, card, done){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  const r=new SR(); r.lang="en-US"; r.interimResults=false;
  const box=card.querySelector(".rp-score");
  box.innerHTML=`<span class="hint"><span class="rec-dot"></span>Listening…</span>`;
  r.onresult=(e)=>{
    const heard=e.results[0][0].transcript;
    const exp=norm(expected), got=norm(heard);
    let correct=0;
    for(let i=0;i<Math.min(exp.length,got.length);i++) if(exp[i]===got[i]) correct++;
    const sc=exp.length?Math.round(correct/exp.length*100):0;
    box.innerHTML=`<span class="score-w ${sc>=70?"ok":"bad"}">${sc}%</span> <span class="hint">you said: “${esc(heard)}”</span>`;
    recordStudy(); done();
  };
  r.onerror=()=>{ box.innerHTML=`<span class="hint">Didn't catch that — try again</span>`; };
  r.onend=()=>{};
  try{ r.start(); }catch(e){ box.innerHTML=`<span class="hint">Mic unavailable</span>`; done(); }
}

// ---------- 6. mock test ----------
let mock={qs:[],i:0,correct:0,timer:null,left:300};
function mockStart(){
  if(vocab.length<4){ toast("Add at least 4 words first"); return; }
  const pool=[...vocab].sort(()=>Math.random()-.5).slice(0,10);
  const types=["listen","reverse","spell"];
  mock={qs:pool.map(v=>({v,type:types[Math.floor(Math.random()*3)]})),i:0,correct:0,left:300,timer:null};
  $("mockArea").style.display=""; $("mockDone").style.display="none"; $("mockDone").innerHTML="";
  mockRender();
  clearInterval(mock.timer);
  mock.timer=setInterval(()=>{
    mock.left--;
    $("mockTimer").textContent=Math.floor(mock.left/60)+":"+String(mock.left%60).padStart(2,"0");
    if(mock.left<=0) mockFinish();
  },1000);
}
function mockDistractors(v, key){
  const others=vocab.filter(x=>x.w!==v.w).sort(()=>Math.random()-.5).slice(0,3).map(x=>x[key]||x.w);
  return [...others, (key==="m"?(v.m||"(no meaning)"):v.w)].sort(()=>Math.random()-.5);
}
function mockRender(){
  const q=mock.qs[mock.i], Q=$("mockQ"), O=$("mockOpts"), I=$("mockInput");
  $("mockQNum").textContent=`Question ${mock.i+1}/${mock.qs.length}`;
  $("mockProg").style.width=(mock.i/mock.qs.length*100)+"%";
  O.innerHTML=""; I.style.display="none"; I.value="";
  $("mockNext").textContent="Check"; $("mockNext").onclick=mockCheck;
  const pick=(t)=>{
    const b=document.createElement("button"); b.className="qopt"; b.textContent=t;
    b.onclick=()=>{ O.querySelectorAll(".qopt").forEach(x=>x.classList.remove("sel")); b.classList.add("sel"); };
    O.appendChild(b);
  };
  if(q.type==="listen"){
    Q.innerHTML=`<div class="hint">🔊 Listen and pick the meaning:</div><button class="btn big" id="mockHear" style="margin:8px 0">🔊 Hear the word</button>`;
    $("mockHear").onclick=()=>safeSpeak(q.v.w); safeSpeak(q.v.w);
    mockDistractors(q.v,"m").forEach(pick);
  }else if(q.type==="reverse"){
    Q.innerHTML=`<div class="hint">Which word means:</div><div class="mock-word">${esc(q.v.m||"(no meaning)")}</div>`;
    mockDistractors(q.v,"w").forEach(pick);
  }else{
    Q.innerHTML=`<div class="hint">🔊 Listen and type what you hear:</div><button class="btn big" id="mockHear" style="margin:8px 0">🔊 Hear the word</button>`;
    $("mockHear").onclick=()=>safeSpeak(q.v.w); safeSpeak(q.v.w);
    I.style.display="";
  }
}
function mockCheck(){
  const q=mock.qs[mock.i];
  let ok=false;
  if(q.type==="spell"){
    ok=norm($("mockInput").value).join(" ")===norm(q.v.w).join(" ");
  }else{
    const sel=document.querySelector("#mockOpts .qopt.sel");
    if(!sel){ toast("Pick an answer first"); return; }
    ok=sel.textContent===(q.type==="listen"?(q.v.m||"(no meaning)"):q.v.w);
    sel.classList.add(ok?"ok":"bad");
  }
  if(ok) mock.correct++;
  const ans=q.type==="reverse"?q.v.w:(q.type==="listen"?(q.v.m||q.v.w):q.v.w);
  $("mockOpts").insertAdjacentHTML("beforeend",
    `<div class="hint" style="margin-top:6px">${ok?"✅ Correct":"❌ Correct: <b>"+esc(ans)+"</b>"}</div>`);
  $("mockNext").textContent=mock.i+1>=mock.qs.length?"See result":"Next →";
  $("mockNext").onclick=()=>{ mock.i++; mock.i>=mock.qs.length?mockFinish():mockRender(); };
}
function mockFinish(){
  clearInterval(mock.timer);
  $("mockArea").style.display="none";
  const n=mock.qs.length, c=mock.correct, pct=n?Math.round(c/n*100):0;
  const msg=pct>=80?"🎉 Excellent!":pct>=60?"💪 Good job!":pct>=40?"📖 Keep practicing!":"🌱 Every master was once a beginner.";
  $("mockDone").style.display="";
  $("mockDone").innerHTML=`<div class="score-hero"><div class="score-num" style="color:${pct>=60?"var(--green)":"var(--amber)"}">${pct}%</div>`+
    `<div class="pbar big"><i style="width:${pct}%"></i></div>`+
    `<div><b>${c}/${n}</b> correct</div><div class="hint">${msg}</div></div>`;
  recordStudy();
}

// ---------- 2. full backup ----------
function doBackupExport(){
  const g=id=>{ const el=$(id); return el?el.value:""; };
  const data={
    app:"english-lab", version:1, exportedAt:new Date().toISOString(),
    vocab, sents,
    study:JSON.parse(localStorage.getItem("englab_study")||"{}"),
    daily:JSON.parse(localStorage.getItem("englab_daily")||"{}"),
    settings:{
      ttsProvider:store.get("ttsProvider","elevenlabs"),
      model:g("modelSel"), oaiModel:g("oaiModelSel"), oaiVoice:g("oaiVoiceSel"),
      gglVoice:g("gglVoiceSel"), voice:g("voiceSel"), browserVoice:g("browserVoiceSel"),
      slow:g("slowSpeed"), theme:store.get("theme","light"),
      cramLevel:store.get("cramLevel",""), cramDate:store.get("cramDate",""),
      notifyWord:store.get("notifyWord","")
    }
  };
  download(`english-lab-backup-${localDay(0)}.json`, JSON.stringify(data), "application/json");
  toast("Backup exported 💾");
}
async function doBackupImport(file){
  let d; try{ d=JSON.parse(await file.text()); }catch(e){ toast("Invalid backup file"); return; }
  if(!d||d.app!=="english-lab"){ toast("Not an English Lab backup"); return; }
  if(!confirm(`Restore backup from ${(d.exportedAt||"").slice(0,10)}? Words & sentences will be merged.`)) return;
  const have=new Set(vocab.map(v=>v.w.toLowerCase()));
  (d.vocab||[]).forEach(v=>{
    if(v&&v.w&&!have.has(v.w.toLowerCase())){
      vocab.push({id:v.id||Date.now()+Math.random(),w:v.w,m:v.m||"",ex:v.ex||"",box:v.box||1,last:v.last||0});
      have.add(v.w.toLowerCase());
    }
  });
  const shave=new Set(sents.map(s=>s.t));
  (d.sents||[]).forEach(s=>{
    if(s&&s.t&&!shave.has(s.t)){ sents.push({id:Date.now()+Math.random(),t:s.t}); shave.add(s.t); }
  });
  saveVocab(); saveSents();
  if(d.study) localStorage.setItem("englab_study",JSON.stringify(d.study));
  if(d.daily) localStorage.setItem("englab_daily",JSON.stringify(d.daily));
  const st=d.settings||{};
  ["ttsProvider","model","oaiModel","oaiVoice","gglVoice","voice","browserVoice","theme","cramLevel","cramDate","notifyWord"]
    .forEach(k=>{ if(st[k]!==undefined&&st[k]!=="") store.set(k,st[k]); });
  if(st.slow) $("slowSpeed").value=st.slow;
  applyTheme(); renderProvider(); renderVocab(); buildFcQueue(); renderSents(); renderStreak(); renderStats(); renderCram(); renderWod();
  toast("Backup restored ✅");
}

(function init(){
  const k = store.get("apikey","");
  if(k){ $("apiKey").value = k; }
  const ok = store.get("oaikey",""); if(ok) $("oaiKey").value = ok;
  const gk = store.get("gglkey",""); if(gk) $("gglKey").value = gk;
  const m = store.get("model",""); if(m) $("modelSel").value = m;
  const om = store.get("oaiModel",""); if(om) $("oaiModelSel").value = om;
  const ov = store.get("oaiVoice",""); if(ov) $("oaiVoiceSel").value = ov;
  if("speechSynthesis" in window){ loadBrowserVoices(); speechSynthesis.onvoiceschanged = loadBrowserVoices; }
  renderProvider();
  applyTheme();
  $("themeBtn").onclick=()=>{ store.set("theme", document.body.classList.contains("dark")?"light":"dark"); applyTheme(); };
  $("playAll").onclick=playAllList;
  $("playStop").onclick=()=>{ playAbort=true; stopPlayer(); stopPlaylistUI(); };
  $("wodNotify").onclick=enableDailyWord;
  $("cramSet").onclick=()=>{ store.set("cramLevel",$("cramLevel").value); store.set("cramDate",$("cramDate").value); renderCram(); toast("Goal saved 📅"); };
  $("rpStart").onclick=rpStart;
  $("mockStart").onclick=mockStart;
  $("backupExport").onclick=doBackupExport;
  $("backupImport").onclick=()=>$("backupFile").click();
  $("backupFile").onchange=(e)=>{ if(e.target.files[0]) doBackupImport(e.target.files[0]); e.target.value=""; };
  renderVocab(); buildFcQueue(); renderSents(); renderShadow(); pickDict(); renderStreak();
  buildCefrFilters(); buildExamFilters();
  renderWod(); renderStats(); renderCram(); maybeNotifyWord(false);
  $("cefrSort").onchange = renderVocab;
})();
</script>
<script>
// PWA: register service worker on http(s) only (skipped for file://)
if("serviceWorker" in navigator && /^https?:$/.test(location.protocol)){
  window.addEventListener("load", function(){
    navigator.serviceWorker.register("sw.js").catch(function(){});
  });
}
</script>
</body>
</html>
