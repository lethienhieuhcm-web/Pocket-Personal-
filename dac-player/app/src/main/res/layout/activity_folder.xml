<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_folder.xml — màn hình duyệt thư mục Drive (4.1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Breadcrumb: Drive của tôi / Nhạc / Album ... (bấm để nhảy tới) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/breadcrumbBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/folderStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 1 RecyclerView duy nhất: ConcatAdapter(FolderAdapter, TrackAdapter) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/folderContentList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/folderBackButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lên 1 cấp" />

        <Button
            android:id="@+id/folderPlayPauseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phát / Dừng" />
    </LinearLayout>
</LinearLayout>
