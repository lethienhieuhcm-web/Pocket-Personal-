<?xml version="1.0" encoding="utf-8"?>
<!-- 4.9: Hàng chờ + hẹn giờ ngủ + playlist — trang riêng (không modal/bottom sheet).
     - Kéo-thả để đổi thứ tự, vuốt để xoá.
     - Hẹn giờ: panel inline (không dialog).
     - Playlist: lưu hàng chờ lên D1, mở lại trên mọi máy. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hàng chờ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhấn giữ để kéo đổi thứ tự · vuốt sang để xoá"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hẹn giờ dừng phát"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/sleepStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hẹn giờ: tắt"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/sleepOffButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tắt" />

            <Button
                android:id="@+id/sleep15Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15p" />

            <Button
                android:id="@+id/sleep30Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30p" />

            <Button
                android:id="@+id/sleep60Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60p" />

            <Button
                android:id="@+id/sleepEndButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hết bài" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playlist"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu trên tài khoản, mở được trên mọi máy."
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/playlistNameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tên playlist mới"
                android:inputType="text"
                android:maxLength="80" />

            <Button
                android:id="@+id/savePlaylistButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu hàng chờ" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsList"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/queueStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại" />
    </LinearLayout>
</ScrollView>
