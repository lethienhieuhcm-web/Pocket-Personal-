    const obj = await env.AUTHDB.get("bank/"+s.email+".json");
    if(!obj) return new Response(JSON.stringify({bank:null}), {headers:{"Content-Type":"application/json"}});
    return new Response(await obj.text(), {headers:{"Content-Type":"application/json"}});
