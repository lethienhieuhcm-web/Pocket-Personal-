<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_auth.xml — plan dac-app 1.3: màn hình Đăng nhập / Đăng ký riêng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAC Player"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng nhập để duyệt nhạc trên Google Drive"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mật khẩu (tối thiểu 8 ký tự)"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp" />

    <!-- Lỗi hiển thị inline (rate limit, sai credentials, lỗi mạng...) -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@android:color/holo_red_dark"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng nhập"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/registerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng ký tài khoản mới"
        android:layout_marginBottom="8dp" />

    <!-- 2.2: Quên mật khẩu -->
    <TextView
        android:id="@+id/forgotPasswordButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quên mật khẩu?"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@android:color/holo_blue_dark"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <!-- 2.2: Gửi lại email xác nhận (chỉ hiện khi login báo email_not_verified) -->
    <Button
        android:id="@+id/resendButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gửi lại email xác nhận"
        android:visibility="gone" />

    <!-- 2.4: Đăng nhập bằng Google (Credential Manager) -->
    <Button
        android:id="@+id/googleSignInButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Đăng nhập bằng Google" />
</LinearLayout>
