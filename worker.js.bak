}
async function handleBankPost(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const body = await request.text();
  if(body.length > 500000) return jerr("Too large", 413);
  await env.AUTHDB.put("bank/"+s.email+".json", body, {httpMetadata:{contentType:"application/json"}});
  return new Response(JSON.stringify({ok:true}), {headers:{"Content-Type":"application/json"}});
