/* ---------------- learning path (Memrise) ---------------- */
const PATH_LEVELS = [["A1","Beginner"],["A2","Elementary"],["B1","Intermediate"],["B2","Upper-intermediate"],["C1","Advanced"],["C2","Proficient"]];
function renderPath(){
  const box = $("pathList"); if(!box) return; box.innerHTML = "";
  let firstDue = null;
  PATH_LEVELS.forEach(([lv,name])=>{
    const inV = vocab.filter(v=>(cefrOf(v.w)||"?")===lv);
    const learned = inV.filter(v=>v.box>=3).length;
    const due = inV.filter(v=>v.box<3).length;
    const pct = inV.length ? Math.round(learned/inV.length*100) : 0;
    if(!firstDue && due>0) firstDue = lv;
    const d = document.createElement("div");
    d.className = "path-row" + (firstDue===lv ? " current" : "");
    d.innerHTML = `<span class="cefr" style="background:${CEFR_COLORS[lv]}">${lv}</span>`+
      `<div class="path-meta"><b>${name}</b><span>${inV.length} words &middot; ${learned} mastered</span>`+
      `<div class="pbar"><i style="width:${pct}%"></i></div></div>`+
      `<button class="btn primary path-go" data-lv="${lv}">Study</button>`;
    box.appendChild(d);
  });
  const due = dueCount(), st = streakDays();
  $("pathSummary").textContent = due ? `${due} word${due>1?"s":""} due for review · ${st}d streak` : "Nothing due — add words or pick a level below.";
  $("pathHello").textContent = due ? "👋 Ready to review?" : "👋 Ready to learn?";
  const c = $("pathContinue");
  const target = firstDue || "A1";
  c.textContent = firstDue ? `▶ Continue: ${firstDue}` : "▶ Start: A1 Beginner";
  c.onclick = ()=>studyLevel(target);
  box.querySelectorAll(".path-go").forEach(b=>b.onclick=()=>studyLevel(b.dataset.lv));
}
function studyLevel(lv){
  cefrFilter = lv; examFilter = "ALL";
  buildCefrFilters(); buildExamFilters(); renderVocab(); buildFcQueue();
  switchTab("tab-vocab");
  setTimeout(()=>{ const el = $("flashcard"); if(el) el.scrollIntoView({block:"center"}); },120);
}

