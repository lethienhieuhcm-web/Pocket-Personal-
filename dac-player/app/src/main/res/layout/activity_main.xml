<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml — plan "dac" D2: danh sách nhạc + phát
     1.3: form đăng nhập đã chuyển sang activity_auth.xml (AuthActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Trạng thái USB DAC -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAC Player"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Version (để user biết đang dùng bản nào) -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Redesign 80/20: tabs Bài hát / Album / Nghệ sĩ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/libraryTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bài hát" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Album" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nghệ sĩ" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Danh sách nhạc từ R2 (MainActivity chỉ chạy khi đã đăng nhập) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Điều khiển phát -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/pickButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="File local" />

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phát / Dừng" />

        <!-- 2.1: Nhập nhạc từ Drive share link -->
        <Button
            android:id="@+id/importButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhập từ link" />

        <!-- 4.1: Duyệt nhạc theo thư mục Drive -->
        <Button
            android:id="@+id/folderButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thư mục" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đăng xuất" />
    </LinearLayout>

    <!-- 4.7: Quản lý phiên đăng nhập -->
    <Button
        android:id="@+id/sessionsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phiên đăng nhập"
        android:layout_marginTop="8dp" />

    <!-- 4.8: Tìm kiếm metadata -->
    <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm kiếm"
        android:layout_marginTop="8dp" />

    <!-- 4.9: Hàng chờ + hẹn giờ + playlist -->
    <Button
        android:id="@+id/queueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hàng chờ"
        android:layout_marginTop="8dp" />

    <!-- 1.5: Giấy phép mã nguồn mở (nghĩa vụ LGPL — FFmpeg) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/licensesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giấy phép mã nguồn mở" />
    </LinearLayout>
</LinearLayout>
