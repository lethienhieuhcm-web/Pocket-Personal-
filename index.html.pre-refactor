const KID_LEVELS = [
  {cefr:"A1", icon:"🌱", vi:"Mầm", en:"Sprout"},
  {cefr:"A2", icon:"🌿", vi:"Chồi", en:"Seedling"},
  {cefr:"B1", icon:"🌳", vi:"Cây", en:"Tree"},
  {cefr:"B2", icon:"⭐", vi:"Ngôi sao", en:"Star"},
  {cefr:"C1", icon:"💎", vi:"Kim cương", en:"Diamond"},
  {cefr:"C2", icon:"👑", vi:"Vua", en:"Master"},
];
function kidLevel(cefr){
  return KID_LEVELS.find(k=>k.cefr===cefr) || KID_LEVELS[2];
}
let uiLang = store.get("uiLang", "en"); // default Vietnamese
let uiMode = "adult"; // "kid" | "adult", set from authUser.ageGroup
function t(key){
  return (I18N[uiLang] && I18N[uiLang][key]) || I18N.en[key] || key;
}
function levelLabel(cefr){
  if(uiMode === "kid"){
    const k = kidLevel(cefr);
    return `${k.icon} ${uiLang==="vi"?k.vi:k.en}`;
  }
  return cefr;
}
function applyUIMode(){
  document.body.classList.toggle("kid-mode", uiMode==="kid");
  $("mascot").style.display = uiMode==="kid" ? "" : "none";
  document.querySelector("header h1").innerHTML = '<svg class="ic ic-h"><use href="#i-camera"/></svg> '+esc(t("appName"));

  $("menuTitleLbl").textContent = t("explore");
  $("menuRead").textContent = t("read");
  $("menuAudio").textContent = t("audio");
  $("menuBooks").textContent = uiLang==="vi" ? "S\u00E1ch" : "Books";
  $("menuProgress").textContent = t("progress");
  $("audioLibTitle").textContent = t("audioLibTitle");

  $("snapTitleLbl").textContent = t("snapPage");
  $("snapHint").innerHTML = t("snapHint");
  $("readCameraLbl").textContent = t("takePhoto");
  $("readGalleryLbl").textContent = t("gallery");
  updateReadGo();
  $("pasteLblTxt").textContent = t("pasteText");
  $("readTextInput").placeholder = t("pastePlaceholder");
  $("readResultTitleLbl").textContent = t("tapLearn");
  $("srvReadTitle").textContent = t("myReadings");
  $("srvReadHint").textContent = t("myReadingsHint");
  $("readResultHint").innerHTML = t("readHint");
  $("viewArticle").title = t("viewArticleT");
  $("viewCards").title = t("viewCardsT");
  $("stSentLbl").textContent = t("stSentences");
  $("stLevelLbl").textContent = t("stLevel");
  $("stDaysLbl").textContent = t("stDays");
  $("stWordsLbl").textContent = t("stWords");
  $("profileTitle").textContent = t("profileTitle");
  $("pathTitle").textContent = t("pathTitle");
  $("bankTitle").textContent = t("bankTitle");
  $("unlockTitle").textContent = t("unlockTitle");
  $("unlockHint").textContent = t("unlockHint");
  renderStats(); renderBank(); renderPath();
}

/* ---------- server auth + RBAC ---------- */
const enc = new TextEncoder(), dec = new TextDecoder();
async function deriveKey(password, salt){
  const km = await crypto.subtle.importKey("raw", enc.encode(password), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey(
    {name:"PBKDF2", salt, iterations:100000, hash:"SHA-256"},
    km, {name:"AES-GCM", length:256}, false, ["encrypt","decrypt"]
  );
}
async function encryptData(key, obj){
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = await crypto.subtle.encrypt({name:"AES-GCM", iv}, key, enc.encode(JSON.stringify(obj)));
  return {iv: btoa(String.fromCharCode(...iv)), data: btoa(String.fromCharCode(...new Uint8Array(ct)))};
}
async function decryptData(key, payload){
  const iv = Uint8Array.from(atob(payload.iv), c=>c.charCodeAt(0));
  const ct = Uint8Array.from(atob(payload.data), c=>c.charCodeAt(0));
  const pt = await crypto.subtle.decrypt({name:"AES-GCM", iv}, key, ct);
  return JSON.parse(dec.decode(pt));
}

let authToken = store.get("authToken", null);
let authUser = store.get("authUser", null); // {email, role, ageGroup}
let userKey = null; // bank encryption key (from password, RAM only)

function authHeaders(){
  return authToken ? {"Authorization": "Bearer "+authToken} : {};
}
async function apiCall(path, opts={}){
  const r = await fetch(path, {
    ...opts,
    headers: {"Content-Type":"application/json", ...authHeaders(), ...(opts.headers||{})},
  });
  const j = await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(j.error || ("HTTP "+r.status));
  return j;
}
async function serverRegister(email, password, dob){
  const j = await apiCall("/api/auth/register", {method:"POST", body: JSON.stringify({email, password, dob})});
  return j;
}
async function serverLogin(email, password){
  const j = await apiCall("/api/auth/login", {method:"POST", body: JSON.stringify({email, password})});
  authToken = j.token; authUser = {email: j.email, role: j.role, ageGroup: j.ageGroup||"adult"};
  store.set("authToken", authToken); store.set("authUser", authUser);
  uiMode = authUser.ageGroup;
  applyUIMode();
  const salt = enc.encode("bank-"+j.email.toLowerCase());
  userKey = await deriveKey(password, salt);
  bank = await loadServerBank();
  loadServerReadings();
  return authUser;
}
async function serverLogout(){
  try{ await apiCall("/api/auth/logout", {method:"POST"}); }catch(e){}
  authToken = null; authUser = null; userKey = null; bank = [];
  store.set("authToken", null); store.set("authUser", null);
  // Clear the scan view, then load this (guest) profile's scan history
  readData = []; curScanId = null; selSentIdx = -1; hideSentBar();
  $("readSents").innerHTML = ""; $("readArticle").innerHTML = "";
  $("readResultCard").style.display = "none"; $("readPreview").style.display = "none";
  readCanvas = null; updateReadGo();
  loadScanHist();
  resetPlayAllBtn(); curServerReadingId = null; loadServerReadings();
  renderStats(); renderBank(); renderPath(); updateAuthUI();
}
async function loadServerBank(){
  if(!authToken || !userKey) return [];
  try{
    const j = await apiCall("/api/bank");
    if(!j.bank) return [];
    return await decryptData(userKey, j.bank);
  }catch(e){ return []; }
}
// Unlock after session restore: re-derive key from password (throws on wrong password)
async function unlockBank(password){
  if(!authUser || !authToken) throw new Error("No session");
  const salt = enc.encode("bank-"+authUser.email.toLowerCase());
  const key = await deriveKey(password, salt);
  const j = await apiCall("/api/bank");
  let data = [];
  if(j.bank) data = await decryptData(key, j.bank); // wrong password → throws
  userKey = key; bank = data;
  renderStats(); renderBank(); renderPath(); updateAuthUI();
}
async function saveServerBank(){
  if(!authToken || !userKey) return;
  try{
    const payload = await encryptData(userKey, bank.slice(-500));
    await apiCall("/api/bank", {method:"POST", body: JSON.stringify({bank: payload})});
  }catch(e){}
}
function updateAuthUI(){
  const btn = $("userBtn");
  if(authUser){
    // Locked session (restored without key) shows 🔒 so it never looks like an empty account
    const ic = !userKey ? "i-lock" : (authUser.role === "admin" ? "i-crown" : "i-user");
    btn.innerHTML = `<svg class="ic"><use href="#${ic}"/></svg>`;
    btn.title = authUser.email + " (" + authUser.role + (userKey ? "" : ", locked") + ")";
  }else{
    btn.innerHTML = `<svg class="ic"><use href="#i-key"/></svg>`; btn.title = "Login";
  }
  // Show/hide admin tab
  const at = $("tabBtnAdmin");
  if(at) at.style.display = authUser && authUser.role === "admin" ? "" : "none";
}

/* ---------- auth UI ---------- */
function openAuth(){ renderAuthMain(); $("authBox").style.display = "flex"; }
function closeAuth(){ $("authBox").style.display = "none"; }
$("userBtn").onclick = openAuth;
function openAuth(){ renderAuthMain(); $("authBox").style.display = "flex"; }
function closeAuth(){ $("authBox").style.display = "none"; }
$("userBtn").onclick = openAuth;
$("authBox").addEventListener("click", e=>{ if(e.target.id==="authBox") closeAuth(); });

let authMode = "login"; // "login" | "reg"
function renderAuthMain(){
  const body = $("authBody");
  const closeBtn = `<button class="gptX" onclick="closeAuth()" title="Close"><svg class="ic"><use href="#i-close"/></svg></button>`;
  let h = "";
  if(authUser){
    const isAdmin = authUser.role === "admin";
    h += `${closeBtn}<div class="gptWrap">
      <div class="gptAvatarBig">${esc(authUser.email[0].toUpperCase())}</div>
      <h1 class="gptH1" style="font-size:21px;word-break:break-all">${esc(authUser.email)}</h1>
      <p class="gptHint">${isAdmin?"<svg class='ic'><use href='#i-crown'/></svg> ADMINISTRATOR":"<svg class='ic'><use href='#i-book'/></svg> LEARNER"} · <svg class='ic'><use href='#i-lock'/></svg> ${t("bankEncrypted")}</p>`;
    if(!userKey){
      h += `<p class="gptHint"><svg class="ic"><use href="#i-lock"/></svg> <b>${t("lockedTitle")}</b> ${t("lockedHint")}</p>
        <label class="gptLabel">${t("passPh")}</label>
        <input class="gptInput" id="authUnlockPass" type="password" autocomplete="current-password">
        <button class="gptBtn" id="authUnlockBtn"><svg class="ic"><use href="#i-unlock"/></svg> ${t("unlockData")}</button>`;
    }
    if(isAdmin) h += `<button class="gptBtnGhost" id="authGoAdmin"><svg class="ic"><use href="#i-crown"/></svg> ${t("adminPanel")}</button>`;
    h += `<button class="gptBtnGhost" id="authLogout"><svg class="ic"><use href="#i-logout"/></svg> ${t("logout")}</button>
      <div class="gptFoot"><a>${t("gptTerms")}</a> · <a>${t("gptPrivacy")}</a></div>
    </div>`;
  }else{
    const isReg = authMode === "reg";
    h += `${closeBtn}<div class="gptWrap">
      <div class="gptLogo"><svg class="ic"><use href="#i-book"/></svg></div>
      <h1 class="gptH1">${isReg?t("gptCreateTitle"):t("gptWelcomeBack")}</h1>
      <label class="gptLabel">${t("emailPh")}</label>
      <input class="gptInput" id="authEmail" type="email" autocomplete="email" autocapitalize="off">
      <label class="gptLabel">${t("passPh")}</label>
      <input class="gptInput" id="authPass" type="password" autocomplete="current-password">
      <div id="regDobWrap" style="display:none">
        <label class="gptLabel">🎂 ${t("dobLbl")}</label>
        <input class="gptInput" id="authDob" type="date" max="${new Date().toISOString().slice(0,10)}">
      </div>
      <button class="gptBtn" id="gptContinue">${t("gptContinue")}</button>
      <div class="gptSwitch">${isReg?t("gptHaveAccount"):t("gptNoAccount")} <a id="gptSwitchMode">${isReg?t("gptLogIn"):t("gptSignUp")}</a></div>
      <div class="gptFoot"><a>${t("gptTerms")}</a> · <a>${t("gptPrivacy")}</a></div>
    </div>`;
  }
  body.innerHTML = h;
  if(authUser){
    if($("authUnlockBtn")) $("authUnlockBtn").onclick = async ()=>{
      const pw = $("authUnlockPass").value;
      if(!pw){ toast("Enter password"); return; }
      try{ await unlockBank(pw); renderAuthMain(); toast("Unlocked 🔓"); }
      catch(e){ toast("Wrong password"); }
    };
    $("authLogout").onclick = async ()=>{ await serverLogout(); renderAuthMain(); toast("Logged out"); };
    if($("authGoAdmin")) $("authGoAdmin").onclick = ()=>{ closeAuth(); switchTab("admin"); };
  }else{
    const isReg = authMode === "reg";
    const doAuth = async ()=>{
      const em = $("authEmail").value.trim().toLowerCase(), pw = $("authPass").value;
      if(!em || !pw){ toast("Enter email and password"); return; }
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){ toast("Enter a valid email address"); return; }
      try{
        if(isReg){
          const dob = $("authDob").value;
          if(!dob){ toast("Pick your birth date 🎂"); $("regDobWrap").style.display = "block"; return; }
          const j = await serverRegister(em, pw, dob);
          toast(j.role==="admin" ? "Welcome, Admin! 👑" : j.ageGroup==="kid" ? "Chào bé! 🦉" : "Account created! 🎉");
        }
        await serverLogin(em, pw);
        renderStats(); renderBank(); renderPath(); updateAuthUI();
        restoreLastScan(); // show this account's last scan (survives refresh)
        closeAuth(); toast(`Welcome!`);
        switchTab("scan");
      }catch(e){ toast(e.message); }
    };
    $("gptContinue").onclick = ()=>{
      if(!isReg){ doAuth(); return; }
      // register: show DOB on first tap, register on second
      const w = $("regDobWrap");
      if(w.style.display === "none"){ w.style.display = "block"; toast("Pick birth date, then tap Continue again 🎂"); }
      else doAuth();
    };
    $("gptSwitchMode").onclick = ()=>{ authMode = isReg ? "login" : "reg"; renderAuthMain(); };
    $("authPass").onkeydown = e=>{ if(e.key==="Enter") doAuth(); };
  }
}

/* ---------- admin panel ---------- */
async function renderAdmin(){
  const box = $("adminContent");
  if(!authUser || authUser.role !== "admin"){
    box.innerHTML = '<div class="hint">Admin only.</div>'; return;
  }
  box.innerHTML = '<div class="hint">Loading…</div>';
  try{
    const [usersJ, insightsJ] = await Promise.all([
      apiCall("/api/admin/users"),
      fetch("/api/insights").then(r=>r.json()),
    ]);
    let h = `<h4 style="margin:12px 0 8px"><svg class="ic ic-h"><use href="#i-user"/></svg> Users (${usersJ.users.length})</h4>`;
    usersJ.users.forEach(u=>{
      const isSelf = u.email === authUser.email;
      h += `<div class="profileitem" style="cursor:default">
        <div class="profileavatar">${esc(u.email[0].toUpperCase())}</div>
        <div style="flex:1"><div style="font-weight:700;word-break:break-all">${esc(u.email)} ${u.role==="admin"?"<svg class='ic'><use href='#i-crown'/></svg>":""}</div>
        <div class="hint">${new Date(u.created).toLocaleDateString()}</div></div>
        ${!isSelf ? `<span class="hint" style="margin-right:8px">${u.role}</span>
        <button class="btn ghost delUser" data-user="${esc(u.email)}" style="padding:8px 10px"><svg class="ic"><use href="#i-trash"/></svg></button>` : '<span class="hint">you</span>'}
      </div>`;
    });
    h += `<h4 style="margin:16px 0 8px"><svg class="ic ic-h"><use href="#i-chart"/></svg> Corpus stats</h4>
      <div class="hint">Learners: <b>${insightsJ.learners||0}</b> · Scans: <b>${insightsJ.scans||0}</b></div>
      <div class="hint">CEFR: ${Object.entries(insightsJ.cefr||{}).map(([k,v])=>k+":"+v).join(" ")}</div>
      <div class="hint" style="margin-top:8px">Top looked up: <b>${(insightsJ.topLookups||[]).slice(0,8).map(x=>x.w).join(", ")||"—"}</b></div>`;
    box.innerHTML = h;
    box.querySelectorAll(".delUser").forEach(btn=>{
      btn.onclick = async ()=>{
        if(!confirm("Delete "+btn.dataset.user+"?")) return;
        try{
          await fetch("/api/admin/users/"+encodeURIComponent(btn.dataset.user), {method:"DELETE", headers: authHeaders()});
          toast("Deleted"); renderAdmin();
        }catch(e){ toast("Error"); }
      };
    });
  }catch(e){
    box.innerHTML = '<div class="hint">Error: '+esc(e.message)+'</div>';
  }
}

/* ---------- books: upload PDF, auto-split lessons ---------- */
$("bookUploadBtn").onclick = ()=>{ if(!authToken){ toast("Login first"); openAuth(); return; } $("bookFile").click(); };
$("bookFile").onchange = async ()=>{
  const f = $("bookFile").files[0];
  if(!f) return;
  if(f.size > 50*1024*1024){ toast("Max 50MB"); return; }
  const title = prompt("Book title:", f.name.replace(/\.pdf$/i,"")) || "Untitled";
  toast("Uploading…");
  try{
    const buf = await f.arrayBuffer();
    const r = await fetch("/api/books/upload", {
      method: "POST",
      headers: {...authHeaders(), "Content-Type": "application/pdf", "X-Book-Title": encodeURIComponent(title)},
      body: buf,
    });
    const j = await r.json();
    if(!r.ok) throw new Error(j.error||"Upload failed");
    toast("Uploaded! Processing… 📚");
    renderBookList();
  }catch(e){ toast(e.message); }
  $("bookFile").value = "";
};
async function renderBookList(){
  const box = $("bookList");
  $("bookDetailCard").style.display = "none";
  $("chapterCard").style.display = "none";
  if(!authToken){ box.innerHTML = '<div class="hint">Login to see your books.</div>'; return; }
  box.innerHTML = '<div class="hint">Loading…</div>';
  try{
    const j = await apiCall("/api/books");
    if(!j.books.length){ box.innerHTML = '<div class="hint">No books yet. Upload a PDF to start.</div>'; return; }
    box.innerHTML = "";
    j.books.forEach(b=>{
      const d = document.createElement("div");
      d.className = "profileitem";
      d.innerHTML = `<div class="profileavatar"><svg class="ic big"><use href="#i-book"/></svg></div>
        <div style="flex:1"><div style="font-weight:700">${esc(b.title)}</div>
        <div class="hint">${b.status==="processing" ? "⏳ Processing…" : b.chapters+" lessons"}</div></div>
        <span style="font-size:20px">›</span>`;
      if(b.status !== "processing") d.onclick = ()=>openBook(b.id, b.title);
      box.appendChild(d);
    });
  }catch(e){ box.innerHTML = '<div class="hint">Error: '+esc(e.message)+'</div>'; }
}
async function openBook(id, title){
  $("bookDetailTitleTxt").textContent = title;
  $("bookDetailCard").style.display = "";
  const box = $("bookChapters");
  box.innerHTML = '<div class="hint">Loading…</div>';
  try{
    const j = await apiCall("/api/books/"+id);
    box.innerHTML = "";
    j.chapters.forEach((c, i)=>{
      const d = document.createElement("div");
      d.className = "profileitem";
      const lv = c.cefr || "B1";
      d.innerHTML = `<span class="cefr ${lv}">${uiMode==="kid"?kidLevel(lv).icon:lv}</span>
        <div style="flex:1"><div style="font-weight:700">${esc(c.title)}</div>
        <div class="hint">${c.sentences.length} sentences</div></div>
        <span style="font-size:20px">›</span>`;
      d.onclick = ()=>openChapter(c);
      box.appendChild(d);
    });
  }catch(e){ box.innerHTML = '<div class="hint">Error: '+esc(e.message)+'</div>'; }
}
function openChapter(c){
  $("chapterTitleTxt").textContent = c.title;
  $("chapterCard").style.display = "";
  const box = $("chapterSents");
  box.innerHTML = "";
  c.sentences.forEach(s=>{
    box.appendChild(makeSentenceEl(s, c.cefr, null));
  });
  window.scrollTo(0,0);
}
$("bookBack").onclick = ()=>{ $("bookDetailCard").style.display = "none"; };
$("chapterBack").onclick = ()=>{ $("chapterCard").style.display = "none"; };

/* ---------- tabs ---------- */
function switchTab(name){
  hideDictPop();
  try{ const ap=$("audioLibPlayer"); if(ap){ ap.pause(); } }catch(e){}
  ["scan","read","audio","books","progress","admin"].forEach(n=>{
    $("tab"+n[0].toUpperCase()+n.slice(1)).classList.toggle("active", name===n);
    const btn = $("tabBtn"+n[0].toUpperCase()+n.slice(1));
    if(btn) btn.classList.toggle("active", name===n);
  });
  if(name==="admin") renderAdmin();
  if(name==="books") renderBookList();
  if(name==="audio") renderAudioLib();
  window.scrollTo(0,0);
}
$("homeBtn").onclick = ()=>switchTab("scan");
document.querySelectorAll(".menutile").forEach(b=>{ b.onclick = ()=>switchTab(b.dataset.go); });

/* ---------- init ---------- */
(function init(){
  // Fresh start (2026-10-05): wipe all local data from the previous test round
  if(store.get("dataV", 0) < 2){
    try{ Object.keys(localStorage).filter(k=>k.startsWith("elab_")).forEach(k=>localStorage.removeItem(k)); }catch(e){}
    store.set("dataV", 2);
  }
  const savedModel = store.get("model", "eleven_turbo_v2_5");
  $("modelSel").value = savedModel;
  loadVoices();
  updateAuthUI();
  // Restore UI mode from saved session
  if(authUser && authUser.ageGroup) uiMode = authUser.ageGroup;
  $("langBtn").textContent = uiLang.toUpperCase();
  applyTheme(); initArticlePlayer();
  applyUIMode();
  // Try to restore session
  (async ()=>{
    if(authToken){
      try{
        const me = await apiCall("/api/auth/me");
        authUser = {email: me.email, role: me.role, ageGroup: me.ageGroup||"adult"};
        uiMode = authUser.ageGroup; applyUIMode();
        store.set("authUser", authUser);
        updateAuthUI();
        loadServerReadings();
        // Bank stays encrypted until the user unlocks with their password —
        // the 🔒 icon + unlock card make this visible instead of looking empty
      }catch(e){
        authToken = null; authUser = null;
        store.set("authToken", null); store.set("authUser", null);
        updateAuthUI();
      }
    }
    renderStats(); renderBank(); renderPath();
    restoreLastScan(); // last scan comes back after refresh
    if(!authUser) setTimeout(()=>openAuth(), 800);
  })();
  if("serviceWorker" in navigator){
    navigator.serviceWorker.register("sw.js").catch(()=>{});
  }
})();
</script>
</body>
</html>
