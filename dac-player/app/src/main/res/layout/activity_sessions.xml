<?xml version="1.0" encoding="utf-8"?>
<!-- 4.7: Quản lý phiên đăng nhập — trang riêng (không modal).
     Liệt kê các thiết bị đang đăng nhập, thu hồi từng phiên hoặc tất cả. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phiên đăng nhập"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/sessionsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Các thiết bị đang đăng nhập tài khoản của bạn."
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/revokeOthersButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng xuất tất cả thiết bị khác"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sessionsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/sessionsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại"
        android:layout_marginTop="8dp" />
</LinearLayout>
