$("settingsBox").onclick = e=>{ if(e.target===$("settingsBox")) $("settingsClose").onclick(); };

/* ---------- read & learn ---------- */
function splitSents(text){
  return cleanOCRText(text).replace(/\s*\n\s*/g," ")
    .split(/(?<=[.!?])\s+/)
    .map(s=>s.trim()).filter(s=>s.length>10);
}

/* Remove browser/app UI junk: URLs, tab bars, taskbars — keep article text only */
function cleanOCRText(text){
  const lines = text.split("\n");
  const kept = [];
  for(let line of lines){
    line = line.trim();
    if(!line) continue;
    if(/https?:\/\//i.test(line)) continue;                    // URLs
    if(/\/\d{4}\/\d{2}\//.test(line)) continue;                // date paths like /2026/10/04/
    if(/\b\w+\.(com|org|net|io|vn|edu)\b/i.test(line) && /[^\w.]/.test(line)) continue; // domains
    if((line.match(/>/g)||[]).length >= 2) continue;           // tab bars: > A > B >
    if(line.length < 20) continue;                            // UI fragments: X, +, end
    const letters = (line.match(/[A-Za-z]/g)||[]).length;
    if(letters < line.length * 0.6) continue;                 // mostly symbols
    kept.push(line);
  }
  return kept.join("\n");
}

/* ---------- CEFR sentence classifier (heuristic) ---------- */
function classifyCEFR(sent){
  const words = sent.match(/[A-Za-z]+(?:'[a-z]+)?/g) || [];
  if(!words.length) return null;
  const avgLen = words.join("").length / words.length;
  const nWords = words.length;
  const hasSub = /\b(because|although|though|while|whereas|unless|until|since|if|when|that|which|who|whom|whose)\b/i.test(sent);
  const hasPass = /\b(am|is|are|was|were|been|be)\s+\w+ed\b/i.test(sent);
  const hasPerf = /\b(have|has|had)\s+\w+ed\b/i.test(sent);
  const longRatio = words.filter(w => w.length >= 8).length / words.length;
  let s = 0;
  s += Math.min(nWords / 4, 5);
  s += Math.min(Math.max(0, avgLen - 3.5) * 2, 4);
  s += longRatio * 6;
  s += hasSub ? 2 : 0;
  s += hasPass ? 1.5 : 0;
  s += hasPerf ? 1 : 0;
  if(s < 4) return "A1";
  if(s < 7) return "A2";
  if(s < 10) return "B1";
  if(s < 13) return "B2";
  if(s < 16) return "C1";
  return "C2";
}

/* ---------- sentence bank: app learns your level ---------- */
let bank = []; // NEVER load from shared localStorage — per-user isolation required
// One-time migration: clear old shared bank keys (rl_ was wrong, elab_ is the real prefix)
try{ localStorage.removeItem("rl_bank"); localStorage.removeItem("elab_bank"); }catch(e){}
function saveBank(){
  bank = bank.slice(-500);
  // Only save to server when fully authenticated (token + key)
  // Otherwise keep in memory only — NEVER write to shared storage
  if(authToken && userKey){ saveServerBank(); }
}

function normSent(s){
  return s.toLowerCase().replace(/[^a-z0-9\s]/g,"").replace(/\s+/g," ").trim();
}
function addToBank(sentences){
  const now = Date.now();
  const have = new Set(bank.map(b => normSent(b.t)));
  let added = 0;
  sentences.forEach(s => {
    const n = normSent(s);
    if(n.length < 10) return;
    // skip near-duplicates: 80%+ word overlap with existing
    let dup = have.has(n);
    if(!dup){
      const words = new Set(n.split(" "));
      for(const b of bank){
        const bw = new Set(normSent(b.t).split(" "));
        const inter = [...words].filter(w=>bw.has(w)).length;
        const union = new Set([...words, ...bw]).size;
        if(union > 0 && inter/union > 0.8){ dup = true; break; }
      }
    }
    if(!dup){
      bank.push({ t: s, cefr: classifyCEFR(s) || "B1", ts: now });
      have.add(n);
      added++;
    }
  });
  bank = bank.slice(-500);
  saveBank();
  renderStats(); renderBank(); renderPath();
  return added;
}

function bankLevel(){ // estimated level or null
  if(!bank.length) return null;
  const dist = {A1:0,A2:0,B1:0,B2:0,C1:0,C2:0};
  bank.forEach(b => { if(dist[b.cefr]!==undefined) dist[b.cefr]++; });
  const weights = {A1:1,A2:2,B1:3,B2:4,C1:5,C2:6};
  let total = 0, sum = 0;
  for(const lv in dist){ total += dist[lv]; sum += dist[lv]*weights[lv]; }
  const avg = total ? sum/total : 3;
  return avg<1.5?"A1":avg<2.5?"A2":avg<3.5?"B1":avg<4.5?"B2":avg<5.5?"C1":"C2";
}
function renderStats(){
  const locked = !!(authUser && !userKey);
  $("unlockCard").style.display = locked ? "" : "none";
  const has = bank.length > 0;
  $("progressDash").style.display = has ? "" : "none";
  $("emptyBankCard").style.display = (!has && !locked) ? "" : "none";
  if(!has) return;
  const dist = {A1:0,A2:0,B1:0,B2:0,C1:0,C2:0};
  bank.forEach(b => { if(dist[b.cefr]!==undefined) dist[b.cefr]++; });
  const level = bankLevel() || "B1";
  // stat tiles
  $("stSent").textContent = bank.length;
  $("stLevel").textContent = uiMode==="kid" ? kidLevel(level).icon : level;
  const days = new Set(bank.map(b=>new Date(b.ts||Date.now()).toDateString())).size;
  $("stDays").textContent = days;
  const words = bank.reduce((n,b)=>n + String(b.t).split(/\s+/).length, 0);
  $("stWords").textContent = words>999 ? (words/1000).toFixed(1)+"k" : words;
  // profile
  const total = bank.length;
  $("levelEstimate").innerHTML = `Estimated reading level: <b style="color:var(--accent);font-size:20px">${uiMode==="kid"?kidLevel(level).icon+" "+kidLevel(level).name:level}</b>`;
  const colors = {A1:"#4ade80",A2:"#a3e635",B1:"#facc15",B2:"#fb923c",C1:"#f87171",C2:"#c084fc"};
  const lvLbl = lv => uiMode==="kid" ? kidLevel(lv).icon : lv;
  let bars = "";
  for(const lv of ["A1","A2","B1","B2","C1","C2"]){
    const pct = total ? Math.round(dist[lv]/total*100) : 0;
    bars += `<div class="row" style="margin:5px 0"><span style="width:34px;font-weight:800;font-size:14px">${lvLbl(lv)}</span><div style="flex:1;background:var(--card2);border-radius:6px;height:14px;overflow:hidden"><div style="width:${pct}%;height:100%;background:${colors[lv]};transition:width .5s"></div></div><span style="width:40px;text-align:right;font-size:13px;color:#6e6e80">${dist[lv]}</span></div>`;
  }
  $("levelBars").innerHTML = bars;
}

let bankQ = "", bankLv = "";
function renderBank(){
  if(!bank.length) return;
  $("bankCount").textContent = bank.length;
  // level filter options
  const sel = $("bankFilter");
  const cur = sel.value;
  sel.innerHTML = `<option value="">${t("allLevels")}</option>` +
    ["A1","A2","B1","B2","C1","C2"].map(lv=>`<option value="${lv}" ${cur===lv?"selected":""}>${uiMode==="kid"?kidLevel(lv).icon+" "+kidLevel(lv).name:lv}</option>`).join("");
  const box = $("bankList");
  box.innerHTML = "";
  const q = bankQ.trim().toLowerCase();
  [...bank].reverse().forEach((b, idx) => {
    if(bankLv && b.cefr !== bankLv) return;
    if(q && !String(b.t).toLowerCase().includes(q)) return;
    const realIdx = bank.length - 1 - idx;
    box.appendChild(makeSentenceEl(b.t, b.cefr, ()=>{
      bank.splice(realIdx, 1); saveBank(); renderStats(); renderBank(); renderPath();
    }));
  });
  if(!box.children.length) box.innerHTML = `<div class="hint">${t("noMatch")}</div>`;
}
$("bankSearch").oninput = e=>{ bankQ = e.target.value; renderBank(); };
$("bankFilter").onchange = e=>{ bankLv = e.target.value; renderBank(); };

$("bankClear").onclick = ()=>{
  if(!confirm("Clear the entire sentence bank?")) return;
  bank = []; saveBank(); renderStats(); renderBank(); renderPath();
};
$("unlockBtn").onclick = async ()=>{
  const pw = $("unlockPass").value;
  if(!pw){ toast("Enter password"); return; }
  try{ await unlockBank(pw); $("unlockPass").value = ""; toast("Unlocked 🔓"); }
  catch(e){ toast("Wrong password"); }
};

/* ---------- learning path from bank data ---------- */
const LV_ORDER = ["A1","A2","B1","B2","C1","C2"];
const LV_W = {A1:1,A2:2,B1:3,B2:4,C1:5,C2:6};
const LV_COLOR = {A1:"#4ade80",A2:"#a3e635",B1:"#facc15",B2:"#fb923c",C1:"#f87171",C2:"#c084fc"};

function renderPath(){
  const card = $("pathCard"), box = $("pathContent");
  if(bank.length < 5){
    card.style.display = "";
    box.innerHTML = `<div class="hint">📷 Scan at least ${5-bank.length} more sentence${5-bank.length>1?"s":""} and I'll build your personalized learning path.</div>`;
    return;
  }
  card.style.display = "";
  const recent = bank.slice(-30);
  let sum = 0;
  recent.forEach(b => sum += LV_W[b.cefr] || 3);
  const avg = sum / recent.length;
  const curIdx = Math.min(5, Math.max(0, Math.round(avg)-1));
  const cur = LV_ORDER[curIdx];
  const next = curIdx < 5 ? LV_ORDER[curIdx+1] : null;

  // Progress: share of recent sentences at next level or above
  let pct = 100, needMsg = "";
  if(next){
    const nw = LV_W[next];
    const hit = recent.filter(b => (LV_W[b.cefr]||0) >= nw).length;
    pct = Math.round(hit / recent.length * 100);
    const need = Math.max(0, Math.ceil(recent.length*0.4) - hit);
    needMsg = need > 0
      ? `Read <b>${need}</b> more ${next}-level sentence${need>1?"s":""} to level up`
      : `Ready to level up! Keep reading ${next} material.`;
  } else {
    needMsg = "You've reached C2 — keep challenging yourself!";
  }

  // Personalized recommendations from data
  const recs = [];
  const dist = {};
  recent.forEach(b => dist[b.cefr] = (dist[b.cefr]||0)+1);
  const curShare = (dist[cur]||0)/recent.length;
  if(next && curShare > 0.6){
    recs.push(`🎯 <b>Push harder:</b> ${Math.round(curShare*100)}% of what you read is ${cur}. Try ${next}-level articles (news, essays) to stretch.`);
  }
  // Vocabulary sophistication trend
  const words = recent.join(" ").match(/[A-Za-z]{8,}/g) || [];
  const avgLong = words.length / recent.length;
  if(avgLong < 1.5){
    recs.push(`📝 <b>Vocabulary:</b> your texts use simple words (avg ${avgLong.toFixed(1)} long words/sentence). Tap unfamiliar words to learn them.`);
  }
  // Consistency
  const days = new Set(bank.map(b => new Date(b.ts).toDateString())).size;
  if(days < 3 && bank.length >= 10){
    recs.push(`📅 <b>Consistency:</b> you've scanned on ${days} day${days>1?"s":""}. A little every day beats cramming.`);
  }
  // Variety
  const uniqStarts = new Set(recent.map(b => b.t.slice(0,20).toLowerCase())).size;
  if(uniqStarts < recent.length * 0.7){
    recs.push(`🔄 <b>Variety:</b> some sentences look similar. Try different topics — tech, science, stories.`);
  }
  if(!recs.length && next){
    recs.push(`✅ <b>On track:</b> good mix of levels. Keep reading ${next} material to advance.`);
  }

  box.innerHTML = `
    <div class="pathlevel">
      <span class="pathbadge" style="background:${LV_COLOR[cur]}">${cur}</span>
      <div style="flex:1">
        <div style="font-weight:700">Level ${cur}${next ? ` → ${next}` : ""}</div>
        <div class="hint">${needMsg}</div>
      </div>
    </div>
    ${next ? `<div class="pathbar"><div style="width:${pct}%"></div></div>
    <div class="hint" style="text-align:right;margin-top:4px">${pct}% to ${next}</div>` : ""}
    <div style="margin-top:10px">${recs.map(r=>`<div class="rec">${r}</div>`).join("")}</div>
    <div class="hint" style="margin-top:8px">Based on your last ${recent.length} sentences · ${bank.length} total</div>
  `;
}
let readCanvas = null, readTessLoading = null;

$("readCamera").onclick = ()=>$("readFileCam").click();
$("readGallery").onclick = ()=>$("readFileLib").click();
// Android: capture="environment" opens camera directly. iOS Chrome: capture is buggy,
// so leave it off and let iOS show the native picker (Take Photo / Photo Library).
if(!/iPad|iPhone|iPod/.test(navigator.userAgent)){
  $("readFileCam").setAttribute("capture", "environment");
}
$("readFileCam").onchange = e=>handleReadFile(e.target.files[0]);
$("readFileLib").onchange = e=>handleReadFile(e.target.files[0]);

function handleReadFile(file){
  if(!file) return;
  const img = new Image();
  img.onload = ()=>{
    const MAXW = 1600;
    const scale = Math.min(1, MAXW / img.width);
    const c = document.createElement("canvas");
    c.width = Math.max(1, Math.round(img.width*scale));
    c.height = Math.max(1, Math.round(img.height*scale));
    c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
    readCanvas = c;
    const pv = $("readPreview");
    pv.src = c.toDataURL("image/jpeg", 0.85);
    pv.style.display = "block";
    updateReadGo();
    $("readResultCard").style.display = "none";
    URL.revokeObjectURL(img.src);
  };
  img.onerror = ()=>toast("Can't read the image file");
  img.src = URL.createObjectURL(file);
}

function loadReadTesseract(){
  if(readTessLoading) return readTessLoading;
  readTessLoading = new Promise((res, rej)=>{
    if(window.Tesseract) return res();
    const s = document.createElement("script");
    s.src = "https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js";
    s.onload = res;
    s.onerror = ()=>rej(new Error("Can't download OCR engine — check connection"));
    document.head.appendChild(s);
  });
  return readTessLoading;
}

async function runReadOCR(){
  if(!readCanvas){ toast("Take or pick a photo first"); return; }
  const btn = $("readGo"); btn.disabled = true;
  $("readProg").style.display = "block";
  const setP = (p, msg)=>{
    $("readBar").style.width = Math.round(p*100)+"%";
    if(msg) $("readStatus").textContent = msg;
  };
  try{
    setP(0.03, "Downloading OCR engine (first time only)…");
    await loadReadTesseract();
    setP(0.08, "Starting…");
    const worker = await Tesseract.createWorker("eng", 1, {
      logger: m=>{
        if(m.status==="recognizing text")
          setP(0.1 + m.progress*0.9, "Reading… "+Math.round(m.progress*100)+"%");
      }
    });
    const { data } = await worker.recognize(readCanvas);
    await worker.terminate();
    const text = (data.text||"").trim();
    $("readProg").style.display = "none";
    if(!text){ toast("No text found — try a closer, clearer shot"); return; }
    renderReadText(text, {src:"📷"});
    readCanvas = null; // consumed — button now follows the textarea
    switchTab("read");
    toast("Done! Tap a sentence or word.");
  }catch(e){
    $("readProg").style.display = "none";
    toast("OCR error: "+(e.message||e));
  }finally{ updateReadGo(); }
};

/* Reusable interactive sentence: 🔊 hear all, tap word = speak + dict */
function makeSentenceEl(text, cefrLv, onDelete){
  const s = text;
  const lv = cefrLv || classifyCEFR(s) || "B1";
  const div = document.createElement("div");
  div.className = "rsent";
  const body = document.createElement("div");
  body.className = "rbody";
  const btn = document.createElement("button");
  btn.className = "btn ghost rplay";
  btn.innerHTML = '<svg class="ic"><use href="#i-volume"/></svg>';
  btn.title = "Hear sentence";
  btn.onclick = e=>{ e.stopPropagation(); apStop(); safeSpeak(s); };
  body.appendChild(btn);
  const badge = document.createElement("span");
  badge.className = "cefr " + lv;
  badge.textContent = uiMode==="kid" ? kidLevel(lv).icon : lv;
  badge.title = levelLabel(lv);
  body.appendChild(badge);
  // Build words via innerHTML (more reliable rendering than many text nodes)
  const escS = esc(s);
  const wordsHtml = escS.replace(/([A-Za-z]+(?:&#39;[a-z]+)?)/g, '<span class="rword">$1</span>');
  const span = document.createElement("span");
  span.innerHTML = wordsHtml;
  span.querySelectorAll(".rword").forEach(w=>{
    const raw = w.textContent;
    w.onclick = e=>{ e.stopPropagation(); wordAudioUnlock(); openDict(raw, w, true); };
  });
  body.appendChild(span);
  div.appendChild(body);
  if(onDelete){
    const del = document.createElement("button");
    del.className = "btn ghost rdel";
    del.innerHTML = '<svg class="ic"><use href="#i-close"/></svg>';
    del.title = "Delete";
    del.onclick = e=>{ e.stopPropagation(); onDelete(div); };
    div.appendChild(del);
  }
  return div;
}

/* ---------- scan history: survive page refresh ---------- */
let scanHistory = [];
let curScanId = null;
function scanHistKey(){
  const u = authUser && authUser.email ? String(authUser.email).toLowerCase() : "guest";
  return "scans_" + u; // stored via store → elab_ prefix, per-user isolation
}
function loadScanHist(){
  scanHistory = store.get(scanHistKey(), []) || [];
  if(!Array.isArray(scanHistory)) scanHistory = [];
  curScanId = null;
  renderScanHistSel();
}
function saveScanHist(){
  store.set(scanHistKey(), scanHistory.slice(-10));
}
function renderScanHistSel(){
  const sel = $("scanHistSel"), row = $("scanHistRow");
  if(!sel || !row) return;
  if(!scanHistory.length){ row.style.display = "none"; return; }
  row.style.display = "";
  sel.innerHTML = [...scanHistory].reverse().map(s=>{
    const d = new Date(s.ts || Date.now());
    const wc = String(s.text||"").split(/\s+/).filter(Boolean).length;
    const lbl = `${s.src||"📷"} ${d.toLocaleDateString()} ${d.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"})} · ${wc} ${t("wordsU")}`;
    return `<option value="${s.id}"${s.id===curScanId?" selected":""}>${esc(lbl)}</option>`;
  }).join("");
}
function pushScanHist(text, meta){
  meta = meta || {};
  const last = scanHistory[scanHistory.length-1];
  if(last && last.text === text){ curScanId = last.id; }
  else{
    const id = meta.id != null ? meta.id : Date.now();
    scanHistory.push({id, text: String(text).slice(0,30000), ts: meta.ts||Date.now(), src: meta.src||"📷"});
    scanHistory = scanHistory.slice(-10);
    curScanId = id;
  }
  saveScanHist(); renderScanHistSel();
}
function removeScanFromHist(id){
  scanHistory = scanHistory.filter(x=>x.id!==id);
  curScanId = null;
  saveScanHist(); renderScanHistSel();
}
function restoreLastScan(){
  loadScanHist();
  if(scanHistory.length){
    const last = scanHistory[scanHistory.length-1];
    renderReadText(last.text, {skipBank:true, silent:true, id:last.id, src:last.src, ts:last.ts});
  }
}
$("scanHistSel").addEventListener("change", e=>{
  const s = scanHistory.find(x=>String(x.id)===e.target.value);
  if(s) renderReadText(s.text, {skipBank:true, silent:true, id:s.id, src:s.src, ts:s.ts});
});

let readData = []; // [{text, cefr}]
let readView = "article";
let selSentIdx = -1;

let readTitle = "";
function splitTitle(text){
  const lines = String(text).split(/\n+/).map(s=>s.trim()).filter(Boolean);
  if(lines.length > 1 && lines[0].length <= 60 && !/[.?!\u2026:;]$/.test(lines[0]) && lines[0].split(/\s+/).length <= 10){
    return {title: lines[0], body: lines.slice(1).join("\n")};
  }
  const words = String(text).trim().split(/\s+/);
  return {title: words.slice(0,8).join(" ") + (words.length > 8 ? "\u2026" : ""), body: String(text)};
}
function renderReadText(text, opts){
  opts = opts || {};
  const st = splitTitle(text);
  readTitle = st.title;
  const sents = splitSents(st.body);
  readData = sents.map(s=>({text:s, cefr:classifyCEFR(s)||"B1"}));
  selSentIdx = -1; hideSentBar();
  resetPlayAllBtn();
  curServerReadingId = opts.serverId || null;
  renderReadView();
  $("readResultCard").style.display = "block";
  pushScanHist(text, opts);
  if(opts.skipBank) return; // restored from history — bank/analytics already counted
  // Save the article to the server library (logged-in users)
  saveReadingToServer(text, sents);
  // Auto-save to bank: app learns your level from what you read
  const added = addToBank(sents);
  if(added) toast(`Saved ${added} sentence${added>1?"s":""} to your bank 📚`);
  // Anonymous corpus for app improvement (opt-in)
  trackScan(sents);
}

function renderReadView(){
  if(readView==="article") renderArticleView(); else renderCardsView();
  $("readArticle").classList.toggle("on", readView==="article");
  $("readSents").classList.toggle("on", readView==="cards");
  $("viewArticle").classList.toggle("active", readView==="article");
  $("viewCards").classList.toggle("active", readView==="cards");
}

function wordsHtml(s){
  const escS = esc(s);
  return escS.replace(/([A-Za-z]+(?:&#39;[a-z]+)?)/g, '<span class="rword">$1</span>');
}
function bindWords(container, stopProp){
  container.querySelectorAll(".rword").forEach(w=>{
    const raw = w.textContent;
    w.onclick = e=>{ if(stopProp) e.stopPropagation(); wordAudioUnlock(); openDict(raw, w, true); };
  });
}

function renderArticleView(){
  const box = $("readArticle");
  box.innerHTML = "";
  if(!readData.length){ box.innerHTML = '<div class="hint">No clear sentences found.</div>'; return; }
  // Book-page header: date + sentence/word count
  const meta = scanHistory.find(x=>x.id===curScanId);
  const when = meta && meta.ts ? new Date(meta.ts) : new Date();
  const words = readData.reduce((n,d)=>n+String(d.text).split(/\s+/).filter(Boolean).length, 0);
  const head = document.createElement("div");
  head.className = "bookhead";
  head.innerHTML = `<div class="btitle"><button class="bplay" id="artTitlePlay" title="${t("listen")}"><svg viewBox="0 0 24 24" width="20" height="20" fill="#fff"><path d="M8 5.5v13l11-6.5z"/></svg></button>${esc(readTitle || t("readingRoom"))}</div><div class="bsub">${esc(when.toLocaleDateString())} · ${readData.length} ${t("sentencesU")} · ${words} ${t("wordsU")}</div>`;
  box.appendChild(head);
  const tp = $("artTitlePlay");
  if(tp) tp.onclick = e=>{ e.stopPropagation(); openArticlePlayer(); };
  // Group into paragraphs (~4 sentences each) like book paragraphs
  let para = null, count = 0;
  readData.forEach((d, idx)=>{
    if(count % 4 === 0){
      para = document.createElement("p");
      para.className = "apara";
      box.appendChild(para);
    }
    count++;
    const sp = document.createElement("span");
    sp.className = "asent";
    sp.dataset.idx = idx;
    sp.innerHTML = wordsHtml(d.text);
    bindWords(sp, true);
    sp.onclick = ()=>selectArticleSent(idx);
    para.appendChild(sp);
    para.appendChild(document.createTextNode(" "));
  });
}

function renderCardsView(){
  const box = $("readSents");
  box.innerHTML = "";
  if(!readData.length){ box.innerHTML = '<div class="hint">No clear sentences found.</div>'; return; }
  readData.forEach((d, idx)=>{
    box.appendChild(makeSentenceEl(d.text, d.cefr, (div)=>{
      div.remove();
      readData.splice(idx, 1);
      if(!readData.length){ $("readResultCard").style.display = "none"; }
    }));
  });
}

function selectArticleSent(idx){
  document.querySelectorAll(".asent.sel").forEach(x=>x.classList.remove("sel"));
  selSentIdx = idx;
  const sp = document.querySelector(`.asent[data-idx="${idx}"]`);
  if(!sp) return;
  sp.classList.add("sel");
  const d = readData[idx];
  $("sentBarLevel").innerHTML = `<span class="cefr ${d.cefr}">${uiMode==="kid"?kidLevel(d.cefr).icon:d.cefr}</span>`;
  $("sentBarText").textContent = d.text.length>60 ? d.text.slice(0,60)+"…" : d.text;
  $("sentBar").classList.add("show");
}
function hideSentBar(){
  $("sentBar").classList.remove("show");
  document.querySelectorAll(".asent.sel").forEach(x=>x.classList.remove("sel"));
  selSentIdx = -1;
}
$("sentBarPlay").onclick = ()=>{ if(selSentIdx>=0){ apStop(); safeSpeak(readData[selSentIdx].text); } };
$("sentBarClose").onclick = hideSentBar;
$("viewArticle").onclick = ()=>{ readView="article"; hideSentBar(); hideDictPop(); renderReadView(); };
$("viewCards").onclick = ()=>{ readView="cards"; hideSentBar(); hideDictPop(); renderReadView(); };

$("readClear").onclick = ()=>{
  if(!confirm(t("clearScanQ"))) return;
  hideDictPop();
  if(curScanId != null) removeScanFromHist(curScanId);
  readData = []; selSentIdx = -1; curScanId = null; hideSentBar();
  $("readSents").innerHTML = "";
  $("readArticle").innerHTML = "";
  $("readTextInput").value = "";
  $("readResultCard").style.display = "none";
  $("readPreview").style.display = "none";
  readCanvas = null;
  updateReadGo();
};

/* One button for both inputs: photo (OCR) or pasted text */
function updateReadGo(){
  const btn = $("readGo");
  const hasImg = !!readCanvas;
  const hasText = $("readTextInput").value.trim().length > 0;
  btn.disabled = !(hasImg || hasText);
  const lbl = $("readGoLbl"), use = $("readGoUse");
  if(hasImg){ lbl.textContent = t("readGoPhoto"); use.setAttribute("href", "#i-camera"); }
  else if(hasText){ lbl.textContent = t("readGoText"); use.setAttribute("href", "#i-doc"); }
  else { lbl.textContent = t("readGoIdle"); use.setAttribute("href", "#i-book"); }
}
$("readTextInput").addEventListener("input", updateReadGo);
$("readGo").onclick = ()=>{
  if(readCanvas){ runReadOCR(); return; }
  const txt = $("readTextInput").value.trim();
  if(!txt){ toast(t("readGoNeed")); return; }
  renderReadText(txt, {src:"✍️"});
  switchTab("read");
};

/* ---------- i18n + kid/adult UI modes ---------- */
const I18N = {
  en: {
    appName: "Read & Learn", scan: "Scan", progress: "My progress", admin: "Admin",
    snapPage: "Snap a page",
    snapHint: "Take a photo of any English text → tap 🔊 to hear, tap any word for dictionary.",
    takePhoto: "Take photo", gallery: "Gallery", readText: "Read text",
    readGoPhoto: "Read from photo", readGoText: "Process text", readGoIdle: "Create reading",
    readGoNeed: "Take a photo or paste text first",
    pasteText: "Or paste text instead", pastePlaceholder: "Paste English text here…", processText: "Process text",
    tapLearn: "Tap to listen & learn",
    readHint: "🔊 tap sentence to select · tap <b>word</b> = pronunciation + dictionary",
    viewArticleT: "Article view", viewCardsT: "Cards view",
    allLevels: "All levels", noMatch: "No sentences match.",
    stSentences: "Sentences", stLevel: "Level", stDays: "Days", stWords: "Words read",
    profileTitle: "Reading profile", pathTitle: "Learning path", bankTitle: "Sentence bank",
    tapHint: "🔊 hear sentence · tap word = pronunciation + dictionary",
    readingProfile: "Your reading profile",
    learningPath: "Your learning path",
    sentenceBank: "Sentence bank",
    bankHint: "🔊 hear sentence · tap word = pronunciation + dictionary",
    bankEmpty: "Scan some pages and your sentences will appear here.",
    authBrand: "Read & Learn", authTagline: "Your personal English library",
