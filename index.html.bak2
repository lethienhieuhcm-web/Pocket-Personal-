<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#2563eb">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="English Lab">
<link rel="apple-touch-icon" href="icon-180.png">
<meta name="theme-color" content="#1e1e1e">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<title>English Lab — Learn English with ElevenLabs</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#eef3fa;--card:#fff;--text:#16213a;--muted:#67748e;--line:#e3e9f4;
  --primary:#2563eb;--primary-d:#1d4ed8;--primary-soft:#e3ecfd;
  --green:#16a34a;--green-soft:#dcfce7;--red:#ef4444;--red-soft:#fee2e2;
  --amber:#d97706;--amber-soft:#fef3c7;
  --radius:16px;--shadow:0 2px 14px rgba(22,33,58,.08);--accent:#7c3aed;
}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;font-size:15px;line-height:1.5;padding-bottom:100px}
/* ---------- app header (ELSA) ---------- */
header.app{background:linear-gradient(135deg,#2f6fed,#1e40af);color:#fff;padding:22px 16px 18px;border-radius:0 0 26px 26px;box-shadow:var(--shadow);margin-bottom:4px}
.app-head{display:flex;justify-content:space-between;align-items:center}
.app-title{font-size:24px;font-weight:800;letter-spacing:-.3px}
.app-sub{font-size:13px;opacity:.85;margin-top:2px}
.app-streak{background:rgba(255,255,255,.22);border-radius:999px;padding:9px 15px;font-weight:800;font-size:16px;white-space:nowrap}
.app-pills{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.pill{background:rgba(255,255,255,.2);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:600}
.quota{margin-top:10px;font-size:13px;opacity:.93}
.quota b{font-weight:800}
/* ---------- bottom nav ---------- */
nav.tabs{position:fixed;bottom:0;left:0;right:0;z-index:60;display:flex;background:#fff;border-top:1px solid var(--line);padding:6px 2px calc(6px + env(safe-area-inset-bottom));box-shadow:0 -3px 16px rgba(22,33,58,.1)}
nav.tabs button{flex:1;min-width:0;background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 1px;color:var(--muted);font-size:10px;font-weight:700;cursor:pointer;font-family:inherit;position:relative}
nav.tabs button .ico{font-size:22px;line-height:1}
nav.tabs button.active{color:var(--primary)}
nav.tabs button.active .ico{transform:scale(1.18)}
.duebadge{position:absolute;top:0;right:calc(50% - 24px);background:var(--red);color:#fff;font-size:9px;border-radius:999px;padding:1px 6px;font-weight:800}
/* ---------- layout ---------- */
.tab{display:none;padding:2px 12px;max-width:720px;margin:0 auto}
.tab.active{display:block;animation:fade .25s}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;margin:12px 0}
.card h3{margin:0 0 10px;font-size:17px;font-weight:800}
.sec-t{font-size:17px;font-weight:800;margin:18px 4px 4px}
label{display:block;font-size:13px;color:var(--muted);margin:12px 0 4px;font-weight:600}
input[type=text],input[type=password],select,textarea{width:100%;background:#f8fafc;border:1.5px solid var(--line);border-radius:12px;padding:12px;font-size:15px;color:var(--text);font-family:inherit}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary);background:#fff}
.row{display:flex;gap:8px;align-items:center}
.hint{font-size:13px;color:var(--muted);margin-top:8px;line-height:1.5}
.est{font-size:12px;color:var(--muted)}
/* ---------- buttons ---------- */
.btn{border:none;border-radius:12px;padding:12px 16px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;background:#edf1f7;color:var(--text)}
.btn.primary{background:var(--primary);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.32)}
.btn.green{background:var(--green);color:#fff}
.btn.ghost{background:#edf1f7}
.btn.big{width:100%;font-size:16px;padding:14px}
.btn:disabled{opacity:.5}
.iconbtn{min-width:44px;height:44px;border-radius:50%;border:none;background:#edf1f7;font-size:18px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:0}
.iconbtn.learned{background:var(--green-soft)}
/* ---------- filter pills (Cake pastel) ---------- */
#cefrFilters,#examFilters{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}
.fchip{border:1.5px solid var(--line);border-radius:999px;padding:8px 14px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;background:#fff;color:var(--muted)}
.fchip[data-lv=A1]{background:#e0f2fe;border-color:#bae6fd;color:#0284c7}
.fchip[data-lv=A2]{background:#dcfce7;border-color:#bbf7d0;color:#15803d}
.fchip[data-lv=B1]{background:#fef9c3;border-color:#fde68a;color:#a16207}
.fchip[data-lv=B2]{background:#ffedd5;border-color:#fed7aa;color:#c2410c}
.fchip[data-lv=C1]{background:#ffe4e6;border-color:#fecdd3;color:#be123c}
.fchip[data-lv=C2]{background:#ede9fe;border-color:#ddd6fe;color:#6d28d9}
.fchip[data-lv="?"]{background:#f1f5f9;border-color:#e2e8f0;color:#64748b}
.fchip[data-e=IELTS]{background:#fee2e2;border-color:#fecaca;color:#b91c1c}
.fchip[data-e=TOEIC]{background:#e0f2fe;border-color:#bae6fd;color:#0369a1}
.fchip[data-e=TOEFL]{background:#ede9fe;border-color:#ddd6fe;color:#6d28d9}
.fchip.sel{background:var(--primary)!important;border-color:var(--primary)!important;color:#fff!important}
#wordChips{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:9px 14px;font-size:14px;cursor:pointer;font-family:inherit;color:var(--text);font-weight:600}
.chip.sel{background:var(--primary-soft);border-color:var(--primary);color:var(--primary-d)}
/* ---------- vocab cards ---------- */
.vocab-item{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:14px;margin:10px 0}
.vocab-item .w{font-size:18px;font-weight:800;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.vocab-item .m{color:var(--muted);margin-top:4px;font-size:14px}
.vocab-item .ex{margin-top:8px;font-size:13.5px;color:var(--muted);background:#f8fafc;border-radius:10px;padding:9px 11px}
.vocab-item .ops{display:flex;gap:8px;margin-top:10px}
.cefr{font-size:11px;font-weight:800;color:#fff;border-radius:8px;padding:3px 8px;white-space:nowrap}
.exam{font-size:11px;font-weight:800;border-radius:8px;padding:3px 8px;white-space:nowrap}
.box-tag{font-size:11px;color:var(--muted);border:1px solid var(--line);border-radius:8px;padding:3px 8px;background:#f8fafc;white-space:nowrap}
/* ---------- flashcard (Quizlet) ---------- */
#flashcard{background:#fff;border-radius:20px;box-shadow:var(--shadow);min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 22px;cursor:pointer;margin:12px 0;position:relative;overflow:hidden}
#flashcard::before{content:"";position:absolute;top:0;left:0;right:0;height:6px;background:linear-gradient(90deg,var(--primary),#7c3aed)}
#flashcard .fw{font-size:32px;font-weight:800;text-align:center}
#flashcard .fm{font-size:19px;color:var(--muted);margin-top:14px;display:none;text-align:center;font-weight:400}
#flashcard.flipped .fm{display:block}
#flashcard.flipped{animation:flip .3s}
@keyframes flip{from{transform:rotateX(10deg)}to{transform:none}}
.tap-hint{text-align:center;color:var(--muted);font-size:12px;margin:-4px 0 8px}
.kbd-hint{font-size:12px;color:var(--muted);margin-top:8px;text-align:center}
.mode-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:4px 0 12px}
.mode-card{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:12px 4px;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:22px;cursor:pointer;font-family:inherit;box-shadow:var(--shadow)}
.mode-card span{font-size:11px;font-weight:700;color:var(--muted)}
.mode-card.cur{border-color:var(--primary);background:var(--primary-soft)}
.mode-card.cur span{color:var(--primary-d)}
/* ---------- quiz ---------- */
.qopt{display:block;width:100%;text-align:left;background:#fff;border:2px solid var(--line);border-radius:14px;padding:14px 16px;font-size:15px;font-weight:600;margin:8px 0;cursor:pointer;font-family:inherit;color:var(--text)}
.qopt.sel{border-color:var(--primary);background:var(--primary-soft)}
.qopt.ok{border-color:var(--green);background:var(--green-soft)}
.qopt.bad{border-color:var(--red);background:var(--red-soft)}
.qprog{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:8px 0}
.qprog i{display:block;height:100%;background:var(--primary);border-radius:99px;transition:width .3s}
/* ---------- learning path (Memrise) ---------- */
.path-hero{text-align:center;background:linear-gradient(135deg,#fff,#eaf0ff)}
.path-hello{font-size:20px;font-weight:800}
.path-row{display:flex;align-items:center;gap:12px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;margin:10px 0}
.path-row.current{border:2px solid var(--primary)}
.path-row .cefr{font-size:14px;padding:6px 10px}
.path-meta{flex:1;min-width:0}
.path-meta b{font-size:15px}
.path-meta>span{display:block;font-size:12.5px;color:var(--muted)}
.pbar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin-top:6px}
.pbar i{display:block;height:100%;background:linear-gradient(90deg,var(--green),#4ade80);border-radius:99px}
.path-go{flex-shrink:0;white-space:nowrap}
/* ---------- ELSA score ---------- */
.score-hero{text-align:center;padding:8px 0 4px}
.score-num{font-size:54px;font-weight:800;line-height:1}
.pbar.big{height:12px;margin:12px 6px 4px}
.score-heard{margin:10px 0;font-size:14px}
.score-words{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.score-w{border-radius:10px;padding:8px 12px;font-size:14px;font-weight:700}
.score-w.ok{background:var(--green-soft);color:#15803d}
.score-w.bad{background:var(--red-soft);color:#b91c1c}
.diff-ok{color:#15803d;font-weight:700}
.diff-bad{color:#b91c1c;font-weight:700;text-decoration:line-through}
.diff-extra{color:#0369a1;font-weight:700}
.score{font-size:15px;font-weight:700}
/* ---------- scan ---------- */
.sent{background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:6px 0;font-size:14px}
#toast{position:fixed;left:50%;bottom:104px;transform:translateX(-50%);background:#16213a;color:#fff;padding:12px 20px;border-radius:999px;font-size:14px;font-weight:600;opacity:0;transition:opacity .25s;z-index:200;pointer-events:none;max-width:90vw;text-align:center}
#toast.show{opacity:1}
.dots{color:var(--muted);font-size:13px;text-align:center;margin:6px 0}
/* ---------- dict modal ---------- */
#dictModal{position:fixed;inset:0;background:rgba(22,33,58,.5);z-index:100;display:flex;align-items:flex-end;justify-content:center}
#dictCard{background:#fff;border-radius:22px 22px 0 0;max-width:640px;width:100%;max-height:85vh;overflow:auto;padding:22px 18px calc(20px + env(safe-area-inset-bottom))}
.dpos{color:var(--primary);font-weight:700;font-style:italic}
.ddef{margin:6px 0}
.dex{color:var(--muted);font-style:italic;margin:2px 0 8px 12px}
.dsyn{font-size:13px;color:var(--muted)}
.rec-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--red);margin-right:6px;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.25}}
#preview{max-width:100%;border-radius:12px;margin-top:10px}
video{max-width:100%;border-radius:12px}
.g{color:var(--green)}.r{color:var(--red)}.y{color:var(--amber)}


/* ---------- upgrades: dark mode + features ---------- */
.theme-btn{background:rgba(255,255,255,.22);border:none;border-radius:999px;width:44px;height:44px;font-size:20px;cursor:pointer;flex-shrink:0}
body.dark{--bg:#0b1220;--card:#16213a;--text:#eef2f7;--muted:#9aa7bd;--line:#2a3a55;--primary:#5b93ff;--primary-d:#8db4ff;--primary-soft:#1b2f5e;--green-soft:#123f27;--red-soft:#4a1d1d;--amber-soft:#4a3413;--accent:#a78bfa;--shadow:0 2px 14px rgba(0,0,0,.45)}
body.dark #flashcard,body.dark .qopt,body.dark .mode-card,body.dark .path-row,body.dark .vocab-item,body.dark .fchip,body.dark .chip{background:var(--card);color:var(--text)}
body.dark input[type=text],body.dark input[type=password],body.dark select,body.dark textarea{background:#0f1a2e;border-color:var(--line);color:var(--text)}
body.dark .vocab-item .ex,body.dark .sent,body.dark .box-tag{background:#0f1a2e;color:var(--muted)}
body.dark .btn{background:#24344f;color:var(--text)}
body.dark .btn.primary{background:var(--primary);color:#fff}
body.dark .iconbtn{background:#24344f}
body.dark nav.tabs{background:#101a30;border-top-color:var(--line)}
body.dark #dictCard{background:#16213a}
.wod-word{font-size:28px;font-weight:800;margin:6px 0}
.stat-bars{display:flex;align-items:flex-end;gap:8px;height:100px;margin-top:8px}
.stat-bar{flex:1;background:linear-gradient(180deg,var(--primary),#7c3aed);border-radius:8px 8px 4px 4px;min-height:8px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:4px}
.stat-bar span{font-size:10px;color:#fff;font-weight:800}
#rpArea{display:flex;flex-direction:column}
.rp-turn{border-radius:14px;padding:12px;margin:10px 0;max-width:94%}
.rp-turn.app{background:var(--primary-soft);align-self:flex-start}
.rp-turn.me{background:var(--green-soft);align-self:flex-end;margin-left:auto}
.rp-role{font-size:12px;font-weight:800;color:var(--muted);margin-bottom:4px}
.rp-text{font-size:16px;font-weight:600}
.rp-ctl{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.rp-score{margin-top:8px}
.rp-done{text-align:center;font-weight:800;margin:12px 0}
.mock-word{font-size:22px;font-weight:800;margin:10px 0;padding:14px;background:var(--primary-soft);border-radius:12px;text-align:center}

</style>

</head>
<body>



<header class="app">
  <div class="app-head">
    <div>
      <div class="app-title">📚 English Lab</div>
      <div class="app-sub">Speak · Listen · Remember</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="theme-btn" id="themeBtn" title="Dark mode">🌙</button>
      <div class="app-streak" id="stStreak">🔥 —</div>
    </div>
  </div>
  <div class="app-pills">
    <span class="pill" id="stApi">◌ api: not connected</span>
    <span class="pill" id="stCredits">credits: —</span>
  </div>
  <div id="quota" class="quota">No API key yet — open the Settings tab to set it up.</div>
</header>

<nav class="tabs">
  <button data-tab="tab-path" class="active"><span class="ico">🗺️</span>Path</button>
  <button data-tab="tab-vocab"><span class="ico">📚</span>Vocab<span class="duebadge" id="dueBadge" style="display:none"></span></button>
  <button data-tab="tab-quiz"><span class="ico">🎯</span>Quiz</button>
  <button data-tab="tab-shadow"><span class="ico">🎭</span>Shadow</button>
  <button data-tab="tab-settings"><span class="ico">⚙️</span>Settings</button>
</nav>

<!-- ================= TAB: SETTINGS ================= -->
<div class="tab" id="tab-settings">
  <div class="card">
    <h3>🔊 TTS engine</h3>
    <label>Voice engine — all run from this page, no server needed</label>
    <select id="ttsProvider" style="width:100%">
      <option value="elevenlabs">ElevenLabs — paid, best quality</option>
      <option value="browser">Browser built-in — free, offline</option>
      <option value="openai">OpenAI — paid</option>
      <option value="google">Google Cloud — paid, generous free tier</option>
    </select>
    <div class="hint" id="ttsProvHint" style="margin-top:8px"></div>
  </div>

  <div id="prov-elevenlabs">
  <div class="card">
    <h3>🔑 ElevenLabs API key <span class="est">optional</span></h3>
    <div class="hint" style="margin-bottom:8px">✅ Already secured on the server — TTS works without entering anything here. Only add your own key if you want to use the direct API instead.</div>
    <label>Get it at elevenlabs.io → avatar → Profile + API keys</label>
    <div class="row">
      <input type="password" id="apiKey" placeholder="sk_..." style="flex:1">
      <button class="btn ghost" id="toggleKey" style="padding:12px 14px;">👁️</button>
    </div>
    <div class="row" style="margin-top:10px">
      <button class="btn primary" id="saveKey">Save & verify</button>
    </div>
    <div class="hint" id="keyStatus">Key is stored only in this browser (localStorage), never sent anywhere else.</div>
  </div>

  <div class="card">
    <h3>🗣️ Voice</h3>
    <label>Pick a voice (loaded from your account)</label>
    <div class="row">
      <select id="voiceSel" style="flex:1"></select>
      <button class="btn ghost" id="reloadVoices">↻</button>
    </div>
    <label>Model</label>
    <select id="modelSel">
      <option value="eleven_turbo_v2_5">Turbo v2.5 — fast, fewer credits</option>
      <option value="eleven_multilingual_v2">Multilingual v2 — best quality, slower</option>
    </select>
  </div>
  </div><!-- /prov-elevenlabs -->

  <div id="prov-browser" style="display:none">
  <div class="card">
    <h3>🗣️ Browser voice — free</h3>
    <label>Voice from your device (no key needed)</label>
    <div class="row">
      <select id="browserVoiceSel" style="flex:1"></select>
      <button class="btn ghost" id="browserTest">🔊 Test</button>
    </div>
    <div class="hint">Free forever, works offline. Quality depends on your device — Chrome on Android is quite good.</div>
  </div>
  </div><!-- /prov-browser -->

  <div id="prov-openai" style="display:none">
  <div class="card">
    <h3>🔑 OpenAI API key</h3>
    <label>Get it at platform.openai.com → API keys</label>
    <div class="row">
      <input type="password" id="oaiKey" placeholder="sk-..." style="flex:1">
      <button class="btn ghost" id="toggleOaiKey" style="padding:12px 14px;">👁️</button>
    </div>
    <div class="row" style="margin-top:10px">
      <button class="btn primary" id="saveOaiKey">Save & verify</button>
    </div>
    <div class="hint" id="oaiStatus">Key is stored only in this browser (localStorage), never sent anywhere except api.openai.com.</div>
  </div>
  <div class="card">
    <h3>🗣️ OpenAI voice</h3>
    <label>Model</label>
    <select id="oaiModelSel">
      <option value="tts-1">tts-1 — fast, $15 / 1M chars</option>
      <option value="tts-1-hd">tts-1-hd — best quality, $30 / 1M chars</option>
      <option value="gpt-4o-mini-tts">gpt-4o-mini-tts — cheaper</option>
    </select>
    <label>Voice</label>
    <select id="oaiVoiceSel">
      <option value="alloy">alloy</option>
      <option value="echo">echo</option>
      <option value="fable">fable</option>
      <option value="onyx">onyx</option>
      <option value="nova">nova</option>
      <option value="shimmer">shimmer</option>
    </select>
  </div>
  </div><!-- /prov-openai -->

  <div id="prov-google" style="display:none">
  <div class="card">
    <h3>🔑 Google Cloud API key</h3>
    <label>Google Cloud Console → enable Text-to-Speech API → Credentials → create API key</label>
    <div class="row">
      <input type="password" id="gglKey" placeholder="AIza..." style="flex:1">
      <button class="btn ghost" id="toggleGglKey" style="padding:12px 14px;">👁️</button>
    </div>
    <div class="row" style="margin-top:10px">
      <button class="btn primary" id="saveGglKey">Save & verify</button>
    </div>
    <div class="hint" id="gglStatus">Free tier: 4M chars/month (Standard voices) — plenty for learning. Key stays in this browser.</div>
  </div>
  <div class="card">
    <h3>🗣️ Google voice</h3>
    <label>Voice (loaded from your Google account)</label>
    <div class="row">
      <select id="gglVoiceSel" style="flex:1"></select>
      <button class="btn ghost" id="reloadGglVoices">↻</button>
    </div>
  </div>
  </div><!-- /prov-google -->

  <div class="card">
    <h3>🐢 Slow playback</h3>
    <label>Slow playback speed: <b id="speedVal">0.75x</b></label>
    <input type="range" id="slowSpeed" min="0.5" max="1" step="0.05" value="0.75" style="width:100%">
    <div class="hint">Applies to 🐢 slow playback on every engine.</div>
  </div>

  <div class="card">
    <h3>💾 Full backup</h3>
    <div class="hint">Save everything (words, sentences, streak, settings — <b>not</b> API keys) into one file. Restore on any device with one tap.</div>
    <div class="row" style="margin-top:10px">
      <button class="btn primary" id="backupExport">⬇ Export</button>
      <button class="btn ghost" id="backupImport">⬆ Import</button>
      <input type="file" id="backupFile" accept=".json,application/json" style="display:none">
    </div>
  </div>

  <div class="card">
    <h3>ℹ️ How to use</h3>
    <div class="hint">
      • <b>🗺️ Path:</b> follow your CEFR learning path, level by level.<br>
      • <b>📚 Vocab:</b> add words → 🔊 hear pronunciation, 🐢 slow playback, flip flashcards to review.<br>
      • <b>📷 Scan</b> (in Vocab): snap a book page/sign → read text → 1-tap add sentences/words to your bank.<br>
      • <b>✍️ Dictation</b> (in Vocab): listen → type <b>verbatim</b> what you hear → get graded per word.<br>
      • <b>🎭 Shadow:</b> listen to the sample → 🎙️ record yourself shadowing → hear your voice → compare.<br>
      • <b>🎯 Quiz:</b> listening quiz — hear the word, pick the meaning.<br>
      • <b>📖 EN–EN dictionary:</b> English definitions, phonetics, examples (free, no key needed).<br>
      • Generated audio is <b>cached</b> on device — replay costs nothing.<br>
      • Engines: <b>ElevenLabs</b> (paid, best quality) · <b>Browser</b> (free, offline) · <b>OpenAI</b> (paid) · <b>Google Cloud</b> (free tier 4M chars/mo).
    </div>
  </div>

