<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Cài đặt — thiết kế v4 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cài đặt"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#e6edf3"
                android:gravity="center" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <!-- Group: Phát nhạc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHÁT NHẠC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b949e"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gapless"
                    android:textSize="14sp"
                    android:textColor="#e6edf3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chuyển bài không khoảng trống"
                    android:textSize="12sp"
                    android:textColor="#8b949e" />
            </LinearLayout>

            <Switch
                android:id="@+id/gaplessSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff10" />

        <!-- Group: Cache -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CACHE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b949e"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/cacheSizeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dung lượng tối đa"
                android:textSize="14sp"
                android:textColor="#e6edf3" />

            <TextView
                android:id="@+id/cacheSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 GB"
                android:textSize="13sp"
                android:textColor="#8b949e" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff10" />

        <Button
            android:id="@+id/clearCacheButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xóa cache"
            android:layout_marginTop="8dp" />

        <!-- Group: Tài khoản -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TÀI KHOẢN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b949e"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng xuất" />

        <!-- Group: Thông tin -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b949e"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phiên bản"
                android:textSize="14sp"
                android:textColor="#e6edf3" />

            <TextView
                android:id="@+id/versionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#8b949e" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff10" />

        <Button
            android:id="@+id/licensesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giấy phép mã nguồn mở"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
