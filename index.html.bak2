<div class="toast" id="toast"></div>
<audio id="player" style="display:none"></audio>

<!-- modal tu dien Anh-Anh -->
<div id="dictModal" style="display:none">
  <div id="dictCard">
    <div class="row" style="justify-content:space-between;align-items:center">
      <h3 style="margin:0">📖 <span id="dictTitle"></span></h3>
      <button class="iconbtn" id="dictClose">✕</button>
    </div>
    <div id="dictBody" style="margin-top:6px"></div>
  </div>
</div>
<script>
"use strict";
/* ============================================================
   English Lab — single-file app. Data: localStorage.
   Audio cache: IndexedDB (key = voice|model|text).
   ============================================================ */
const $ = id => document.getElementById(id);
const API = "https://api.elevenlabs.io/v1";

function toast(msg, ms=3500){
  const t = $("toast"); t.textContent = msg; t.style.display = "block";
  clearTimeout(t._tm); t._tm = setTimeout(()=>t.style.display="none", ms);
}

/* ---------------- storage ---------------- */
const store = {
  get(k, d){ try{ const v = localStorage.getItem("elab_"+k); return v===null? d : JSON.parse(v);}catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem("elab_"+k, JSON.stringify(v)); }catch(e){ toast("Storage full — couldn't save!"); } }
};

/* ---------------- audio cache (IndexedDB) ---------------- */
const idb = {
  db:null,
  open(){ return new Promise((res, rej)=>{
    if(this.db) return res(this.db);
    const r = indexedDB.open("elevenlab", 1);
    r.onupgradeneeded = ()=> r.result.createObjectStore("audio", {keyPath:"key"});
    r.onsuccess = ()=>{ this.db = r.result; res(this.db); };
    r.onerror = ()=> rej(r.error);
  });},
  async get(key){
    try{
      const db = await this.open();
      return new Promise(res=>{
        const tx = db.transaction("audio").objectStore("audio").get(key);
        tx.onsuccess = ()=> res(tx.result ? tx.result.blob : null);
        tx.onerror = ()=> res(null);
      });
    }catch(e){ return null; }
  },
  async put(key, blob){
    try{
      const db = await this.open();
      db.transaction("audio","readwrite").objectStore("audio").put({key, blob});
    }catch(e){/* cache miss is fine — play directly */}
  }
};
const memCache = new Map(); // blobURL per key, current session only

/* ---------------- TTS providers ---------------- */
const TTS_HINTS = {
  elevenlabs: "Best quality. Ready to use — secured on server, no key needed. (Optional: add your own key below for direct API.)",
  browser: "Free forever, works offline, no key. Quality depends on your device.",
  openai: "Paid. Simple per-character pricing.",
  google: "Paid, but free tier 4M chars/month (Standard voices) — plenty for learning.",
};
let ttsProvider = store.get("ttsProvider", "");
// ElevenLabs works via secure server proxy (no key needed in browser).
// A personal key in Settings (optional) uses the direct API instead.
if(!ttsProvider) ttsProvider = "elevenlabs";
// Auto-fallback to free browser voice when the saved provider needs a key that isn't saved
// (elevenlabs excluded — it works through the secure proxy)
const _needKey0 = {openai:"oaikey", google:"gglkey"}[ttsProvider];
if(_needKey0 && !store.get(_needKey0,"")) ttsProvider = "browser";
function renderProvider(){
  ["elevenlabs","browser","openai","google"].forEach(p=>{
    const d = $("prov-"+p); if(d) d.style.display = (p===ttsProvider) ? "" : "none";
  });
  $("ttsProvider").value = ttsProvider;
  $("ttsProvHint").textContent = TTS_HINTS[ttsProvider];
  if(ttsProvider==="browser"){ refreshQuota(false); return; }
  if(ttsProvider==="elevenlabs"){ refreshQuota(false); loadVoices(); return; }
  const needKey = {openai:"oaikey", google:"gglkey"}[ttsProvider];
  if(needKey && store.get(needKey,"")){ refreshQuota(false); return; }
  $("stApi").textContent = "◌ api: not connected";
  $("stCredits").textContent = "credits: —";
  $("quota").innerHTML = "No API key yet — pick an engine and save its key above.";
}
$("ttsProvider").onchange = ()=>{
  ttsProvider = $("ttsProvider").value;
  store.set("ttsProvider", ttsProvider);
  renderProvider();
};

/* ---------------- ElevenLabs API ---------------- */
function apiKey(){ return ($("apiKey").value || "").trim(); }

async function elFetch(path, opts={}){
  const key = apiKey();
  if(key){
    const r = await fetch(API+path, {
      ...opts,
      headers:{ "xi-api-key": key, "Content-Type":"application/json", ...(opts.headers||{}) }
    });
    if(r.status===401) throw new Error("Wrong or expired API key (401)");
    if(!r.ok) throw new Error("ElevenLabs error "+r.status);
    return r;
  }
  // No local key: use secure server proxy (key stays on server, never in browser)
  if(path==="/voices"){
    const r = await fetch("/api/voices");
    if(!r.ok) throw new Error("Voice load failed ("+r.status+")");
    return r;
  }
  if(path==="/user"){
    const r = await fetch("/api/quota");
    if(!r.ok) throw new Error("Quota check failed ("+r.status+")");
    return r;
  }
  if(path.startsWith("/text-to-speech/")){
    const voice = path.split("/").pop();
    let body = {};
    try{ body = JSON.parse(opts.body||"{}"); }catch(e){}
    const r = await fetch("/api/tts", {
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ text: body.text||"", voice_id: voice, model_id: body.model_id })
    });
    if(!r.ok) throw new Error("TTS proxy error "+r.status);
    return r;
  }
  throw new Error("Enter your own API key in Settings for this feature");
}

function estCredits(text){
  const n = text.trim().length;
  if(ttsProvider==="browser") return "free";
  if(ttsProvider==="elevenlabs") return "≈ "+n+" credits";
  return "≈ "+n+" chars";
}

async function getAudioURL(text){
  if(ttsProvider==="openai") return getOaiURL(text);
  if(ttsProvider==="google") return getGglURL(text);
  return getElURL(text);
}

async function getElURL(text){
  const voice = $("voiceSel").value, model = $("modelSel").value;
  if(!voice){ toast("Pick a voice in the .env tab"); throw new Error("no voice"); }
  const key = "el|"+voice+"|"+model+"|"+text;
  if(memCache.has(key)) return memCache.get(key);
  const cached = await idb.get(key);
  if(cached){
    const url = URL.createObjectURL(cached);
    memCache.set(key, url);
    return url;
  }
  const r = await elFetch(`/text-to-speech/${voice}`, {
    method:"POST", body: JSON.stringify({text, model_id:model})
  });
  const blob = await r.blob();
  idb.put(key, blob);
  const url = URL.createObjectURL(blob);
  memCache.set(key, url);
  refreshQuota(false);
  return url;
}

/* ---- OpenAI ---- */
function oaiKey(){ return ($("oaiKey").value || "").trim(); }
async function getOaiURL(text){
  const key = oaiKey();
  if(!key){ toast("Enter your OpenAI key in the .env tab first"); throw new Error("no key"); }
  const model = $("oaiModelSel").value, voice = $("oaiVoiceSel").value;
  const ck = "oai|"+model+"|"+voice+"|"+text;
  if(memCache.has(ck)) return memCache.get(ck);
  const cached = await idb.get(ck);
  if(cached){ const url = URL.createObjectURL(cached); memCache.set(ck, url); return url; }
  const r = await fetch("https://api.openai.com/v1/audio/speech", {
    method:"POST",
    headers:{ "Authorization":"Bearer "+key, "Content-Type":"application/json" },
    body: JSON.stringify({model, input:text, voice})
  });
  if(r.status===401) throw new Error("Wrong OpenAI key (401)");
  if(!r.ok) throw new Error("OpenAI error "+r.status);
  const blob = await r.blob();
  idb.put(ck, blob);
  const url = URL.createObjectURL(blob);
  memCache.set(ck, url);
  return url;
}

/* ---- Google Cloud ---- */
function gglKey(){ return ($("gglKey").value || "").trim(); }
async function getGglURL(text){
  const key = gglKey();
  if(!key){ toast("Enter your Google key in the .env tab first"); throw new Error("no key"); }
  const voice = $("gglVoiceSel").value;
  if(!voice){ toast("Load Google voices in the .env tab first"); throw new Error("no voice"); }
  const ck = "ggl|"+voice+"|"+text;
  if(memCache.has(ck)) return memCache.get(ck);
  const cached = await idb.get(ck);
  if(cached){ const url = URL.createObjectURL(cached); memCache.set(ck, url); return url; }
  const r = await fetch("https://texttospeech.googleapis.com/v1/text:synthesize?key="+encodeURIComponent(key), {
    method:"POST",
    headers:{ "Content-Type":"application/json" },
    body: JSON.stringify({
      input:{text},
      voice:{languageCode: voice.split("-").slice(0,2).join("-"), name: voice},
      audioConfig:{audioEncoding:"MP3"}
    })
  });
  if(!r.ok){
    const j = await r.json().catch(()=>({}));
    throw new Error("Google: "+((j.error&&j.error.message)||("HTTP "+r.status)));
  }
  const j = await r.json();
  const bin = atob(j.audioContent);
  const bytes = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
  const blob = new Blob([bytes], {type:"audio/mp3"});
  idb.put(ck, blob);
  const url = URL.createObjectURL(blob);
  memCache.set(ck, url);
  return url;
}
async function loadGglVoices(silent=false){
  const key = gglKey();
  if(!key){ if(!silent) toast("Enter your Google key first"); return; }
  const r = await fetch("https://texttospeech.googleapis.com/v1/voices?key="+encodeURIComponent(key)+"&languageCode=en");
  if(!r.ok){
    const j = await r.json().catch(()=>({}));
    throw new Error("Google: "+((j.error&&j.error.message)||("HTTP "+r.status)));
  }
  const j = await r.json();
  const sel = $("gglVoiceSel"); sel.innerHTML = "";
  (j.voices||[]).filter(v=>v.languageCodes && /^en/i.test(v.languageCodes[0])).forEach(v=>{
    const o = document.createElement("option");
    o.value = v.name; o.textContent = v.name+" ("+v.ssmlGender+")";
    sel.appendChild(o);
  });
  const saved = store.get("gglVoice","");
  if(saved && [...sel.options].some(o=>o.value===saved)) sel.value = saved;
  if(!silent) toast("Loaded "+sel.options.length+" voices");
}

/* ---- Browser built-in (free) ---- */
let browserVoices = [];
function loadBrowserVoices(){
  if(!("speechSynthesis" in window)) return;
  browserVoices = speechSynthesis.getVoices().filter(v=>/^en/i.test(v.lang));
  const sel = $("browserVoiceSel"); if(!sel) return;
  sel.innerHTML = "";
  browserVoices.forEach(v=>{
    const o = document.createElement("option");
    o.value = v.name; o.textContent = v.name+" ("+v.lang+")";
    sel.appendChild(o);
  });
  const saved = store.get("browserVoice","");
  if(saved && browserVoices.some(v=>v.name===saved)) sel.value = saved;
}
function speakBrowserOne(text, rate){
  return new Promise((res, rej)=>{
    const u = new SpeechSynthesisUtterance(text);
    const v = browserVoices.find(v=>v.name===$("browserVoiceSel").value);
    if(v) u.voice = v;
    u.lang = "en-US"; u.rate = rate;
    u.onend = ()=>res();
    u.onerror = e=>rej(new Error("Browser TTS failed: "+(e.error||"unknown")));
    speechSynthesis.cancel();
    speechSynthesis.speak(u);
  });
}
async function speakBrowser(text, {slow=false}={}){
  if(!("speechSynthesis" in window)) throw new Error("Browser TTS not supported here");
  const rate = slow ? parseFloat($("slowSpeed").value) : 1;
  const chunks = chunkText(text, 800); // device voices cut off on very long text
  for(const ch of chunks) await speakBrowserOne(ch, rate);
}

function playURL(url, rate=1){
  return new Promise((res, rej)=>{
    const a = $("player");
    a.src = url; a.playbackRate = rate;
    a.onended = ()=>res(); a.onerror = ()=>rej(new Error("play fail"));
    a.play().catch(rej);
  });
}

async function speak(text, {slow=false}={}){
  if(ttsProvider==="browser") return speakBrowser(text, {slow});
  const rate = slow ? parseFloat($("slowSpeed").value) : 1;
  const maxChunk = ttsProvider==="openai" ? 4000 : 4500; // OpenAI tts limit: 4096 chars
  const chunks = chunkText(text, maxChunk);
  if(chunks.length > 1) toast(`Text is long — splitting into ${chunks.length} chunks`);
  for(const ch of chunks){
    const url = await getAudioURL(ch);
    await playURL(url, rate);
  }
}

// API limit ~5000 chars/req — chunk long text by sentence, each cached separately
function chunkText(text, max=4500){
  const t = text.trim();
  if(t.length <= max) return [t];
  const parts = t.split(/(?<=[.!?])\s+/);
  const chunks = []; let cur = "";
  for(const p of parts){
    if(cur && (cur+" "+p).length > max){ chunks.push(cur.trim()); cur = p; }
    else cur = cur ? cur+" "+p : p;
  }
  if(cur.trim()) chunks.push(cur.trim());
  const out = [];
  for(const c of chunks){
    if(c.length <= max) out.push(c);
    else for(let i=0;i<c.length;i+=max) out.push(c.slice(i,i+max)); // single sentence too long: hard cut
  }
  return out;
}

/* ---------------- settings ---------------- */
async function verifyOai(loud=true){
  try{
    const r = await fetch("https://api.openai.com/v1/models", {
      headers:{ "Authorization":"Bearer "+oaiKey() }
    });
    if(r.status===401) throw new Error("Wrong OpenAI key (401)");
    if(!r.ok) throw new Error("OpenAI error "+r.status);
    $("quota").innerHTML = "OpenAI key <b>OK</b> — pay per character used.";
    $("stCredits").textContent = "tts: openai";
    $("stApi").textContent = "● tts: openai";
    if(loud) toast("OpenAI key OK");
  }catch(e){
    $("stApi").textContent = "◌ api: error";
    if(loud) toast("Error: "+e.message);
  }
}
async function verifyGgl(loud=true){
  try{
    await loadGglVoices(true);
    $("quota").innerHTML = "Google key <b>OK</b> — free tier 4M chars/month (Standard voices).";
    $("stCredits").textContent = "tts: google";
    $("stApi").textContent = "● tts: google";
    if(loud) toast("Google key OK");
  }catch(e){
    $("stApi").textContent = "◌ api: error";
    if(loud) toast("Error: "+e.message);
  }
}
async function refreshQuota(loud=true){
  if(ttsProvider==="browser"){
    $("quota").innerHTML = "Browser TTS — <b>free</b>, offline, no key needed.";
    $("stCredits").textContent = "tts: free";
    $("stApi").textContent = "● tts: browser";
    return;
  }
  if(ttsProvider==="openai"){ await verifyOai(loud); return; }
  if(ttsProvider==="google"){ await verifyGgl(loud); return; }
  try{
    const r = await elFetch("/user");
    const j = await r.json();
    const s = j.subscription || {};
    const used = s.character_count||0, limit = s.character_limit||0;
    const left = limit - used;
    $("quota").innerHTML = `<b>${left.toLocaleString()}</b> / ${limit.toLocaleString()} credits left — plan <b>${s.tier||"?"}</b>`;
    $("stCredits").textContent = "credits: " + left.toLocaleString();
    $("stApi").textContent = "● api: " + (s.tier||"ok");
    if(loud) toast("Key OK — plan "+(s.tier||"?"));
  }catch(e){
    $("stApi").textContent = "◌ api: error";
    if(loud) toast("Error: "+e.message);
  }
}

async function loadVoices(){
  try{
    const r = await elFetch("/voices");
    const j = await r.json();
    const sel = $("voiceSel"); sel.innerHTML = "";
    (j.voices||[]).forEach(v=>{
      const o = document.createElement("option");
      const accent = v.labels && v.labels.accent ? " ("+v.labels.accent+")" : "";
      o.value = v.voice_id; o.textContent = v.name + accent;
      sel.appendChild(o);
    });
    const saved = store.get("voice","");
    if(saved && [...sel.options].some(o=>o.value===saved)) sel.value = saved;
    else {
      // prefer Rachel / Adam if available
      const pref = [...sel.options].find(o=>/rachel/i.test(o.textContent))
                || [...sel.options].find(o=>/adam/i.test(o.textContent));
      if(pref) sel.value = pref.value;
    }
    toast("Loaded "+sel.options.length+" voices");
  }catch(e){ toast("Voice load error: "+e.message); }
}

/* ---------------- tabs ---------------- */
function switchTab(id){
  document.querySelectorAll("nav.tabs button").forEach(x=>x.classList.remove("active"));
  document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));
  const b = document.querySelector(`nav.tabs button[data-tab="${id}"]`);
  if(b) b.classList.add("active");
  const t = $(id); if(t) t.classList.add("active");
  if(id==="tab-path") renderPath();
  if(id==="tab-vocab") renderVocab();
}
document.querySelectorAll("nav.tabs button").forEach(b=>{ b.onclick = ()=>switchTab(b.dataset.tab); });
document.querySelectorAll(".mode-card").forEach(b=>{ b.onclick = ()=>{ if(b.dataset.scroll){ switchTab("tab-vocab"); setTimeout(()=>{ const el=$(b.dataset.scroll); if(el) el.scrollIntoView({behavior:"smooth",block:"start"}); },80); } else switchTab(b.dataset.go); }; });

