<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml — plan "dac"
     USB setup y chang doc Ma145/decent-player (GETTING_STARTED.md):
     - intent-filter USB_DEVICE_ATTACHED để app claim DAC trước kernel driver
     - meta-data trỏ tới usb_audio_device_filter.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MusicApiClient gọi Worker API qua HTTP — bắt buộc -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DriveAuthManager: liệt kê tài khoản Google trên máy (dac-pass) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- required=false để app vẫn cài được trên máy không có USB host -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".DacApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DacPlayer">

        <!-- 1.3: AuthActivity là màn hình đầu tiên (Đăng nhập / Đăng ký).
             MainActivity chỉ chạy khi đã đăng nhập; nhận USB_DEVICE_ATTACHED. -->
        <activity
            android:name=".AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Nhận sự kiện cắm DAC: Android hiện dialog xin quyền,
                 app claim thiết bị trước khi snd-usb-audio của kernel bind -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio_device_filter" />
        </activity>

        <!-- 1.5: Màn hình Giấy phép mã nguồn mở (nghĩa vụ LGPL — FFmpeg).
             Không exported (chỉ mở từ trong app). -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!-- 2.1: Màn hình nhập nhạc từ Drive share link.
             Không exported (chỉ mở từ trong app). -->
        <activity
            android:name=".ImportActivity"
            android:exported="false" />

        <!-- 4.1: Màn hình duyệt nhạc theo thư mục Drive.
             Không exported (chỉ mở từ trong app). -->
        <activity
            android:name=".FolderActivity"
            android:exported="false" />
    </application>
</manifest>
