// CEFR: intl levels A1..C2 for vocab (data: Oxford 3000/5000 first, then CEFR-J + Octanove, top-up via merged CEFR index)
const CEFR_MAP = new Map();
for(const lv in CEFR_LV) for(const w of CEFR_LV[lv].split("|")) CEFR_MAP.set(w, lv);
const CEFR_ORDER = {A1:0,A2:1,B1:2,B2:3,C1:4,C2:5};
const CEFR_COLORS = {A1:"#2e7d32",A2:"#43a047",B1:"#e6a100",B2:"#ef6c00",C1:"#d32f2f",C2:"#7b1fa2"};
function cefrOf(word){ return CEFR_MAP.get((word||"").trim().toLowerCase()) || null; }
function cefrBadge(lv, sm){
  if(!lv) return `<span class="cefr${sm?" sm":""}" style="background:#9e9e9e" title="Not in CEFR data">?</span>`;
  return `<span class="cefr${sm?" sm":""}" style="background:${CEFR_COLORS[lv]}">${lv}</span>`;
}
// exam word sets: IELTS / TOEIC / TOEFL iBT (data: grokwords CEFR+exam CSV, TOEFL-1000 list, TOEIC Service List)
const EXAM_SETS={}; for(const k in EXAM) EXAM_SETS[k]=new Set(EXAM[k]?EXAM[k].split("|"):[]);
function examOf(w){ const lw=(w||"").trim().toLowerCase(); const r=[];
  for(const k of ["IELTS","TOEIC","TOEFL"]) if(EXAM_SETS[k].has(lw)) r.push(k); return r; }
function examTags(w, sm){ return examOf(w).map(e=>`<span class="exam${sm?" sm":""} exam-${e}">${e}</span>`).join(""); }
// due review + streak
function startOfToday(){ const d=new Date(); d.setHours(0,0,0,0); return d.getTime(); }
function dueCount(){
  const now=Date.now(), day=864e5, sod=startOfToday();
  return vocab.filter(v=> v.box<3 && (v.box===1 ? (v.last||0)<sod : (v.last||0)<now-3*day)).length;
}
function localDay(off){ const d=new Date(); d.setDate(d.getDate()+(off||0));
  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
function recordStudy(){
  try{ const k="englab_study"; const d=JSON.parse(localStorage.getItem(k)||"{}");
    d[localDay(0)]=(d[localDay(0)]||0)+1; localStorage.setItem(k, JSON.stringify(d)); }catch(e){}
  logDay('r');
  renderStreak();
}
function streakDays(){
  let d={}; try{ d=JSON.parse(localStorage.getItem("englab_study")||"{}"); }catch(e){}
  let s=0, off = d[localDay(0)] ? 0 : -1;
  while(d[localDay(off)]){ s++; off--; }
  return s;
}
function renderStreak(){ const s=$("stStreak"); if(s) s.textContent="🔥 "+streakDays()+"d"; }
function download(name, text, mime){
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([text],{type:mime||"text/plain"}));
  a.download=name; document.body.appendChild(a); a.click();
  setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); },4000);
}
function sentForWord(w, text){
  const lw = w.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
  return (splitSents(text).find(s=>new RegExp("\\b"+lw+"\\b","i").test(s)) || "");
}

/* ---------------- VOCAB ---------------- */
let fcQueue = [], fcIdx = 0;

let cefrFilter = "ALL";
let examFilter = "ALL";
function buildExamFilters(){
  const box = $("examFilters"); box.innerHTML = "";
  [["ALL","All exams"],"IELTS","TOEIC","TOEFL"].forEach(o=>{
    const key = Array.isArray(o) ? o[0] : o;
    const label = Array.isArray(o) ? o[1] : key;
    const b = document.createElement("button");
    b.className = "fchip" + (examFilter===key ? " sel" : "");
    b.textContent = label; b.dataset.e = key;
    b.onclick = ()=>{ examFilter = key; buildExamFilters(); renderVocab(); };
    box.appendChild(b);
  });
}
function buildCefrFilters(){
  const box = $("cefrFilters"); box.innerHTML = "";
  [["ALL","All"],"A1","A2","B1","B2","C1","C2","?"].forEach(o=>{
    const key = Array.isArray(o) ? o[0] : o;
    const label = Array.isArray(o) ? o[1] : (key==="?" ? "Unknown" : key);
    const b = document.createElement("button");
    b.className = "fchip" + (cefrFilter===key ? " sel" : "");
    b.textContent = label; b.dataset.lv = key;
    b.onclick = ()=>{ cefrFilter = key; buildCefrFilters(); renderVocab(); };
    box.appendChild(b);
  });
}
function renderVocab(){
  const list = $("vList"); list.innerHTML = "";
  // thong ke theo level
  const counts = {A1:0,A2:0,B1:0,B2:0,C1:0,C2:0,"?":0};
  vocab.forEach(v=>{ counts[cefrOf(v.w)||"?"]++; });
  $("cefrStats").innerHTML = Object.keys(counts).map(lv=>
    `<span class="cefr" style="background:${lv==="?"?"#9e9e9e":CEFR_COLORS[lv]};margin:2px 2px 2px 0">${lv==="?"?"?":lv}: ${counts[lv]}</span>`
  ).join("");
  const ecounts = {IELTS:0,TOEIC:0,TOEFL:0};
  vocab.forEach(v=>{ examOf(v.w).forEach(e=>ecounts[e]++); });
  $("examStats").innerHTML = `<span style="color:var(--mut)">exam: </span>` +
    ["IELTS","TOEIC","TOEFL"].map(e=>`<span class="exam exam-${e}" style="margin:2px 2px 2px 0">${e}: ${ecounts[e]}</span>`).join("");
  const due = dueCount();
  const db = $("dueBadge");
  if(due>0){ db.style.display="inline"; db.textContent=due+" due"; } else db.style.display="none";
  $("dueLine").innerHTML = due>0 ? `📅 <b>${due}</b> word${due>1?"s":""} due for review today`
    : "📅 Nothing due — you are all caught up 🎉";
  // loc + sap xep
  const vs = currentList();
  $("vCount").textContent = vs.length + (vs.length!==vocab.length ? "/"+vocab.length : "");
  vs.forEach(v=>{
    const d = document.createElement("div");
    d.className = "vocab-item";
    d.innerHTML = `<div class="w">${esc(v.w)}${cefrBadge(cefrOf(v.w))}${examTags(v.w)}<span class="box-tag">box ${v.box}</span></div>
      <div class="m">${esc(v.m)}</div>${v.ex?`<div class="ex">"${esc(v.ex)}"</div>`:""}
      <div class="ops">
        <button class="iconbtn" data-a="hear">🔊</button>
        <button class="iconbtn" data-a="slow">🐢</button>
        <button class="iconbtn" data-a="dict" title="EN–EN dictionary">📖</button>
        <button class="iconbtn ${v.box>=3?"learned":""}" data-a="learn">✓</button>
        <button class="iconbtn" data-a="del">🗑️</button>
      </div>`;
    d.querySelectorAll("[data-a]").forEach(b=> b.onclick = async ()=>{
      const a = b.dataset.a;
      if(a==="hear") await safeSpeak(v.w);
      else if(a==="slow") await safeSpeak(v.w, {slow:true});
      else if(a==="dict") openDict(v.w);
      else if(a==="learn"){ v.box = 3; saveVocab(); renderVocab(); }
      else if(a==="del"){ vocab = vocab.filter(x=>x.id!==v.id); saveVocab(); renderVocab(); buildFcQueue(); }
    });
    list.appendChild(d);
  });
  renderPath(); renderStats();
}

function esc(s){ return String(s).replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }

async function safeSpeak(text, opt){
  try{ await speak(text, opt||{}); }
  catch(e){ toast("Error: "+e.message); }
}

$("vAdd").onclick = ()=>{
  const w = $("vWord").value.trim();
  if(!w){ toast("Type a word first"); return; }
  vocab.unshift({id:Date.now(), w, m:$("vMean").value.trim(), ex:$("vEx").value.trim(), box:1});
  saveVocab(); logDay('n'); renderVocab(); buildFcQueue();
  $("vWord").value = $("vMean").value = $("vEx").value = "";
  toast("Added: "+w);
};

function buildFcQueue(){
  fcQueue = vocab.filter(v=>v.box<3).sort((a,b)=>a.box-b.box);
  fcIdx = 0; renderFc();
}
function renderFc(){
  $("fcCount").textContent = fcQueue.length ? (fcIdx+1)+"/"+fcQueue.length : "";
  if(!fcQueue.length){ $("fcWord").textContent = "🎉 Done!"; $("fcMean").textContent=""; return; }
  const v = fcQueue[fcIdx];
  $("fcWord").innerHTML = esc(v.w) + cefrBadge(cefrOf(v.w)) + examTags(v.w); $("fcMean").textContent = v.m;
  $("flashcard").classList.remove("flipped");
}
$("flashcard").onclick = ()=>$("flashcard").classList.toggle("flipped");
$("fcHear").onclick = ()=>{ const v=fcQueue[fcIdx]; if(v) safeSpeak(v.w); };
$("fcKnow").onclick = ()=>{
  const v = fcQueue[fcIdx]; if(!v) return;
  v.box = Math.min(3, v.box+1); v.last = Date.now(); saveVocab(); renderVocab();
  fcQueue.splice(fcIdx,1); if(fcIdx>=fcQueue.length) fcIdx=0; renderFc(); recordStudy();
};
$("fcNext").onclick = ()=>{
  const v = fcQueue[fcIdx]; if(!v) return;
  v.box = 1; v.last = Date.now(); saveVocab(); renderVocab();
  fcIdx = (fcIdx+1)%fcQueue.length; renderFc(); recordStudy();
};

/* ---------------- SHADOWING ---------------- */
let curSent = sents[0] || null;

function renderSents(){
  const list = $("sList"); list.innerHTML = "";
  sents.forEach(s=>{
    const d = document.createElement("div");
    d.className = "sent"+(curSent&&s.id===curSent.id?" sel":"");
    d.textContent = s.t;
    d.onclick = ()=>{ curSent = s; renderSents(); renderShadow(); };
    const del = document.createElement("span");
    del.textContent = " ✕"; del.style.cssText = "float:right;color:var(--red);font-weight:700;";
    del.onclick = (e)=>{ e.stopPropagation();
      sents = sents.filter(x=>x.id!==s.id); saveSents();
      if(curSent&&curSent.id===s.id) curSent = sents[0]||null;
      renderSents(); renderShadow();
    };
    d.appendChild(del);
    list.appendChild(d);
  });
}
function renderShadow(){
  $("shSent").textContent = curSent ? curSent.t : "—";
  $("shEst").textContent = curSent ? `${estCredits(curSent.t)} / play` : "";
}
$("sAdd").onclick = ()=>{
  const t = $("sNew").value.trim(); if(!t) return;
  sents.push({id:Date.now(), t}); saveSents(); $("sNew").value=""; renderSents();
};
$("shShuffle").onclick = ()=>{
  if(!sents.length) return;
  curSent = sents[Math.floor(Math.random()*sents.length)];
  renderSents(); renderShadow();
};
$("shPlay").onclick = ()=> curSent && safeSpeak(curSent.t);
$("shSlow").onclick = ()=> curSent && safeSpeak(curSent.t, {slow:true});

let mediaRec = null, recChunks = [], recURL = null;
$("shRec").onclick = async ()=>{
  if(mediaRec && mediaRec.state==="recording"){ mediaRec.stop(); return; }
  try{
    const stream = await navigator.mediaDevices.getUserMedia({audio:true});
    recChunks = [];
    mediaRec = new MediaRecorder(stream);
    mediaRec.ondataavailable = e=>{ if(e.data.size) recChunks.push(e.data); };
    mediaRec.onstop = ()=>{
      stream.getTracks().forEach(t=>t.stop());
      if(recURL) URL.revokeObjectURL(recURL);
      recURL = URL.createObjectURL(new Blob(recChunks,{type:mediaRec.mimeType||"audio/webm"}));
      const a = $("mineAudio"); a.src = recURL; a.style.display = "block";
      $("recStatus").innerHTML = "Recording done — hit ▶️ to hear yourself.";
      $("shRec").innerHTML = "🎙️ Record";
    };
    mediaRec.start();
    $("shRec").innerHTML = '<span class="rec-dot"></span>Recording… tap to stop';
    $("recStatus").textContent = "Recording — shadow the sample!";
  }catch(e){ toast("Can't open mic: "+e.message); }
};
$("shPlayMine").onclick = ()=>{
  if(!recURL){ toast("Record something first"); return; }
  $("mineAudio").play();
};
let recog = null;
function gradeShadow(heard){
  const exp = norm(curSent.t), got = norm(heard);
  let html = "", correct = 0;
  const maxLen = Math.max(exp.length, got.length);
  for(let i=0;i<maxLen;i++){
    const e = exp[i], g = got[i];
    if(e===g){ html += `<span class="score-w ok">${esc(e)}</span>`; correct++; }
    else if(g===undefined){ html += `<span class="score-w bad">[${esc(e)}]</span>`; }
    else if(e===undefined){ html += `<span class="score-w bad">+${esc(g)}</span>`; }
    else { html += `<span class="score-w bad">${esc(g)}</span>`; }
  }
  const score = exp.length ? Math.round(correct/exp.length*100) : 0;
  const emoji = score>=80 ? "🎉" : score>=50 ? "💪" : "📖";
  const col = score>=80 ? "var(--green)" : score>=50 ? "var(--amber)" : "var(--red)";
  $("shScoreOut").innerHTML =
    `<div class="score-hero"><div class="score-num" style="color:${col}">${score}%</div>`+
    `<div class="pbar big"><i style="width:${score}%;background:${col}"></i></div>`+
    `<div class="hint">${emoji} pronunciation match</div></div>`+
    `<div class="score-heard"><span class="hint">I heard:</span> &ldquo;${esc(heard)}&rdquo;</div>`+
    `<div class="hint">Word by word:</div><div class="score-words">${html}</div>`;
  recordStudy();
}
$("shScore").onclick = ()=>{
  if(!curSent){ toast("Pick a sentence first"); return; }
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ $("shScoreOut").innerHTML = '<div class="hint">Speech scoring needs Chrome/Edge — Web Speech API is not available in this browser.</div>'; return; }
  if(recog){ try{ recog.stop(); }catch(e){} }
  recog = new SR(); recog.lang = "en-US"; recog.interimResults = false; recog.maxAlternatives = 1;
  $("shScoreOut").innerHTML = '<div class="hint">🎤 Listening… read the sample sentence aloud, then pause.</div>';
  $("shScore").disabled = true;
  recog.onresult = e=>{ const heard = e.results[0][0].transcript; $("shScore").disabled = false; gradeShadow(heard); };
  recog.onerror = e=>{ $("shScore").disabled = false;
    $("shScoreOut").innerHTML = '<div class="hint">Mic error ('+esc(e.error||"unknown")+') — tap again to retry.</div>'; };
  recog.onend = ()=>{ $("shScore").disabled = false; };
  try{ recog.start(); }catch(e){ $("shScore").disabled = false; toast("Can't start speech recognition: "+e.message); }
};
$("shCompare").onclick = async ()=>{
  if(!curSent){ toast("Pick a sentence first"); return; }
  if(!recURL){ toast("Record something first"); return; }
  toast("Playing sample…");
  await safeSpeak(curSent.t);
  await new Promise(r=>setTimeout(r, 600));
  toast("…now it's you");
  $("mineAudio").play();
};

/* ---------------- QUIZ ---------------- */
let qList = [], qIdx = 0, qScore = 0, qTarget = null;
function pickQuiz(){
  const pool = vocab.filter(v=>v.m && v.m.trim());
  if(pool.length < 4){ toast("Add at least 4 words with meanings first"); return null; }
  return pool.slice().sort(()=>Math.random()-0.5).slice(0, Math.min(10, pool.length));
}
$("qStart").onclick = ()=>{
  qList = pickQuiz(); if(!qList) return;
  qIdx = 0; qScore = 0;
  $("qDone").style.display = "none"; $("qArea").style.display = "block";
  renderQ();
};
function renderQ(){
  const v = qList[qIdx]; qTarget = v;
  $("qProg").textContent = `Question ${qIdx+1}/${qList.length} · score ${qScore}`;
  $("qFeedback").innerHTML = ""; $("qNext").style.display = "none";
  const distract = vocab.filter(x=>x.id!==v.id && x.m && x.m.trim())
    .sort(()=>Math.random()-0.5).slice(0,3).map(x=>x.m);
  const opts = [v.m, ...distract].sort(()=>Math.random()-0.5);
  const box = $("qOpts"); box.innerHTML = "";
  opts.forEach(m=>{
    const b = document.createElement("button");
    b.className = "qopt"; b.textContent = m;
    b.onclick = ()=>answerQ(b, m===v.m, v.m);
    box.appendChild(b);
  });
  safeSpeak(v.w);
}
$("qHear").onclick = ()=>{ if(qTarget) safeSpeak(qTarget.w); };
function answerQ(btn, ok, correctMean){
  [...$("qOpts").children].forEach(b=>{ b.disabled = true; if(b.textContent===correctMean) b.classList.add("ok"); });
  if(ok){ qScore++; $("qFeedback").innerHTML = '<span style="color:var(--green)">✓ Correct!</span>'; }
  else { btn.classList.add("bad"); $("qFeedback").innerHTML = '<span style="color:var(--red)">✗ Wrong.</span>'; }
  $("qNext").style.display = "inline-block";
}
$("qNext").onclick = ()=>{
  qIdx++;
  if(qIdx >= qList.length){
    const pct = Math.round(qScore/qList.length*100);
    $("qArea").style.display = "none";
    const d = $("qDone"); d.style.display = "block";
    d.innerHTML = `<div style="font-size:18px">${pct>=80?"🎉":pct>=50?"💪":"📖"} Quiz done: <b>${qScore}/${qList.length}</b> (${pct}%)</div>
      <div class="row" style="margin-top:10px"><button class="btn primary" id="qRetry">↻ Play again</button></div>`;
    $("qRetry").onclick = ()=>$("qStart").click();
    recordStudy();
  } else renderQ();
};

/* ---------------- BACKUP / IMPORT ---------------- */
$("expCsv").onclick = ()=>{
  if(!vocab.length){ toast("Vocab is empty"); return; }
  const q = s=>'"'+String(s||"").replace(/"/g,'""')+'"';
  const rows = [["word","meaning","example","cefr","exams"]];
  vocab.forEach(v=>rows.push([v.w, v.m, v.ex, cefrOf(v.w)||"", examOf(v.w).join(" ")]));
  download("englab-vocab.csv", "\uFEFF"+rows.map(r=>r.map(q).join(",")).join("\n"), "text/csv;charset=utf-8");
  toast("CSV exported");
};
$("expAnki").onclick = ()=>{
  if(!vocab.length){ toast("Vocab is empty"); return; }
  const clean = s=>String(s||"").replace(/[\r\n\t]+/g," ").trim();
  const lines = vocab.map(v=> clean(v.w)+"\t"+clean(v.m)+(v.ex?"<br>"+clean(v.ex):""));
  download("englab-anki.txt", lines.join("\n"), "text/plain;charset=utf-8");
  toast("Anki file exported — in Anki use File → Import");
};
function splitLine(line, delim){
  const out=[]; let cur="", inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(inQ){
      if(c==='"'){ if(line[i+1]==='"'){cur+='"';i++;} else inQ=false; }
      else cur+=c;
    } else if(c==='"') inQ=true;
    else if(c===delim){ out.push(cur); cur=""; }
    else cur+=c;
  }
  out.push(cur); return out;
}
$("impFile").onchange = async e=>{
  const f = e.target.files[0]; e.target.value = ""; if(!f) return;
  const text = await f.text();
  const lines = text.split(/\r?\n/).filter(l=>l.trim());
  if(!lines.length){ toast("File is empty"); return; }
  const first = lines[0];
  const delim = first.includes("\t") ? "\t" : (first.split(";").length > first.split(",").length ? ";" : ",");
  let rows = lines.map(l=>splitLine(l, delim));
  if(/^(word|front|term)\b/i.test((rows[0][0]||"").trim())) rows.shift();
  const have = new Set(vocab.map(v=>v.w.toLowerCase()));
  let added=0, skipped=0;
  rows.forEach(r=>{
    const w=(r[0]||"").trim().replace(/^"|"$/g,"");
    if(!w || w.length>60 || have.has(w.toLowerCase())){ skipped++; return; }
    vocab.unshift({id:Date.now()+added, w, m:(r[1]||"").trim(), ex:(r[2]||"").trim(), box:1, last:0});
    have.add(w.toLowerCase()); added++;
  });
  saveVocab(); renderVocab(); buildFcQueue();
  toast(`Imported ${added} words`+(skipped?` (${skipped} dupes/skipped)`:""));
};

/* ---------------- DICTATION ---------------- */
let dSent = null, dPlayCount = 0;
function pickDict(){
  if(!sents.length){ toast("Sentence bank is empty"); return; }
  dSent = sents[Math.floor(Math.random()*sents.length)];
  dPlayCount = 0; $("dPlays").textContent = "0";
  $("dInput").value = ""; $("dResultCard").style.display = "none";
  $("dEst").textContent = `${estCredits(dSent.t)} / play (cached = free)`;
}
$("dNew").onclick = pickDict;
$("dPlay").onclick = async ()=>{
  if(!dSent) pickDict();
  if(dPlayCount>=3){ toast("3 plays used up — type your answer"); return; }
  dPlayCount++; $("dPlays").textContent = dPlayCount;
  await safeSpeak(dSent.t);
};
function norm(s){ return s.toLowerCase().replace(/[.,!?;:"'()«»…—–-]/g,"").split(/\s+/).filter(Boolean); }
$("dCheck").onclick = ()=>{
  if(!dSent){ toast("Listen first"); return; }
  const exp = norm(dSent.t), got = norm($("dInput").value);
  if(!got.length){ toast("Type your answer first"); return; }
  let html = "", correct = 0;
  const maxLen = Math.max(exp.length, got.length);
  for(let i=0;i<maxLen;i++){
    const e = exp[i], g = got[i];
    if(e===g){ html += `<span class="diff-ok">${esc(e)}</span> `; correct++; }
    else if(g===undefined){ html += `<span class="diff-bad">[${esc(e)}]</span> `; }
    else if(e===undefined){ html += `<span class="diff-extra">${esc(g)}</span> `; }
    else { html += `<span class="diff-bad">${esc(g)}</span> `; }
  }
  const score = Math.round(correct/exp.length*100);
  $("dScore").innerHTML = score>=80 ? `🎉 <span style="color:var(--green)">${score}%</span>`
    : score>=50 ? `💪 <span style="color:var(--amber)">${score}%</span>`
    : `📖 <span style="color:var(--red)">${score}%</span>`;
  $("dictResult").innerHTML = html + `<div class="hint" style="margin-top:10px">Correct answer:<br><b>${esc(dSent.t)}</b></div>`;
  $("dResultCard").style.display = "block";
  recordStudy();
};
$("dHearSlow").onclick = ()=> dSent && safeSpeak(dSent.t, {slow:true});

/* ---------------- SCAN (OCR) ---------------- */
let scanCanvas = null, tessLoading = null;

$("scanCamera").onclick = ()=>$("scanFileCam").click();
$("scanGallery").onclick = ()=>$("scanFileLib").click();
$("scanFileCam").onchange = e=>handleScanFile(e.target.files[0]);
$("scanFileLib").onchange = e=>handleScanFile(e.target.files[0]);

function handleScanFile(file){
  if(!file) return;
  const img = new Image();
  img.onload = ()=>{
    // downscale to max 1600px: faster OCR, still accurate
    const MAXW = 1600;
    const scale = Math.min(1, MAXW / img.width);
    const c = document.createElement("canvas");
    c.width = Math.max(1, Math.round(img.width*scale));
    c.height = Math.max(1, Math.round(img.height*scale));
    c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
    scanCanvas = c;
    const pv = $("scanPreview");
    pv.src = c.toDataURL("image/jpeg", 0.85);
    pv.style.display = "block";
    $("scanOCR").disabled = false;
    $("ocrResultCard").style.display = "none";
    URL.revokeObjectURL(img.src);
  };
  img.onerror = ()=>toast("Can't read the image file");
  img.src = URL.createObjectURL(file);
}

function loadTesseract(){
  if(tessLoading) return tessLoading;
  tessLoading = new Promise((res, rej)=>{
    if(window.Tesseract) return res();
    const s = document.createElement("script");
    s.src = "https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js";
    s.onload = res;
    s.onerror = ()=>rej(new Error("Can't download the OCR engine — check connection and retry"));
    document.head.appendChild(s);
  });
  return tessLoading;
}

$("scanOCR").onclick = async ()=>{
  if(!scanCanvas){ toast("Take or pick a photo first"); return; }
  const btn = $("scanOCR"); btn.disabled = true;
  $("ocrProg").style.display = "block";
  const setP = (p, msg)=>{
    $("ocrBar").style.width = Math.round(p*100)+"%";
    if(msg) $("ocrStatus").textContent = msg;
  };
  try{
    setP(0.03, "Downloading the OCR engine (first time only, ~15MB)…");
    await loadTesseract();
    setP(0.08, "Starting…");
    // OEM 1 = LSTM_ONLY (numeric for cross-version safety)
    const worker = await Tesseract.createWorker("eng", 1, {
      logger: m=>{
        if(m.status==="recognizing text")
          setP(0.1 + m.progress*0.9, "Reading text… "+Math.round(m.progress*100)+"%");
      }
    });
    const { data } = await worker.recognize(scanCanvas);
    await worker.terminate();
    const text = (data.text||"").trim();
    $("ocrProg").style.display = "none";
    if(!text){ toast("No text found — try a closer, clearer shot"); return; }
    setStagedText(text, "confidence ~"+Math.round(data.confidence||0)+"%");
    toast("Done!");
  }catch(e){
    $("ocrProg").style.display = "none";
    const msg = (e && e.message) ? e.message : String(e);
    toast("OCR error: "+msg);
  }finally{ btn.disabled = false; }
};

$("ocrHear").onclick = ()=>{
  const t = $("ocrText").value.trim();
  if(t) safeSpeak(t); else toast("No text to play yet");
};

function splitSents(text){
  return text.replace(/\s*\n\s*/g," ")
    .split(/(?<=[.!?])\s+/)
    .map(s=>s.trim()).filter(s=>s.length>10);
}
$("ocrToSents").onclick = ()=>{
  const ss = splitSents($("ocrText").value);
  if(!ss.length){ toast("No sentences found"); return; }
  const have = new Set(sents.map(s=>s.t.toLowerCase()));
  let added = 0;
  ss.forEach(t=>{
    if(!have.has(t.toLowerCase())){
      sents.push({id:Date.now()+added, t});
      have.add(t.toLowerCase()); added++;
    }
  });
  saveSents(); renderSents(); renderShadow();
  toast(added ? `Added ${added} sentences to the bank` : "These sentences are already in the bank");
};

let chipSel = new Set();
function updAddWordsBtn(){
  const b = $("ocrAddWords");
  if(chipSel.size){ b.style.display = "inline-block"; b.textContent = `Add ${chipSel.size} selected words`; }
  else b.style.display = "none";
  $("ocrSelectAll").style.display = chipWords.length ? "inline-block" : "none";
}
let chipWords = [], chipShown = [];
function renderChips(){
  const box = $("wordChips"); box.innerHTML = "";
  const minLv = $("chipMinLv").value;
  const exF = $("chipExam").value;
  const show = chipWords.filter(w=>{
    if(exF!=="ALL" && !examOf(w).includes(exF)) return false;
    if(minLv==="ALL") return true;
    const lv = cefrOf(w);
    return lv && CEFR_ORDER[lv] >= CEFR_ORDER[minLv];
  });
  chipShown = show;
  if(!show.length){
    box.innerHTML = '<div class="hint">No words at this level — try a lower filter.</div>';
    return;
  }
  show.forEach(w=>{
    const c = document.createElement("span");
    c.className = "chip" + (chipSel.has(w) ? " sel" : "");
    c.innerHTML = `${esc(w)}${cefrBadge(cefrOf(w), true)}${examTags(w, true)}`;
    c.onclick = ()=>{
      if(chipSel.has(w)){ chipSel.delete(w); c.classList.remove("sel"); }
      else { chipSel.add(w); c.classList.add("sel"); }
      updAddWordsBtn();
    };
    box.appendChild(c);
  });
}
$("chipMinLv").onchange = renderChips;
$("chipExam").onchange = renderChips;
$("ocrWordsBtn").onclick = ()=>{
  const words = (($("ocrText").value||"").match(/[A-Za-z]+(?:'[a-z]+)?/g)||[])
    .map(w=>w.toLowerCase()).filter(w=>w.length>=3);
  const inVocab = new Set(vocab.map(v=>v.w.toLowerCase()));
  chipWords = [...new Set(words)].filter(w=>!inVocab.has(w)).sort();
  chipSel = new Set();
  if(!chipWords.length){
    $("wordChips").innerHTML = '<div class="hint">No new words — they are all in your vocab already.</div>';
    $("ocrAddWords").style.display = "none"; $("ocrSelectAll").style.display = "none";
    return;
  }
  renderChips();
  updAddWordsBtn();
};
$("ocrAddWords").onclick = ()=>{
  if(!chipSel.size) return;
  let n = 0;
  const txt = $("ocrText").value;
  chipSel.forEach(w=>{ vocab.unshift({id:Date.now()+n, w, m:"", ex:sentForWord(w, txt), box:1, last:0}); n++; });
  saveVocab(); renderVocab(); buildFcQueue();
  toast(`Added ${n} words with example sentences — fill in meanings later`);
  chipSel = new Set(); $("wordChips").innerHTML = "";
  $("ocrAddWords").style.display = "none"; $("ocrSelectAll").style.display = "none";
};
$("ocrSelectAll").onclick = ()=>{
  chipShown.forEach(w=>chipSel.add(w));
  renderChips(); updAddWordsBtn();
};

/* ---------------- FILE UPLOAD: PDF / DOCX / TXT ---------------- */
let lastPdfBuffer = null;

$("docPick").onclick = ()=>$("docFile").click();
$("docFile").onchange = e=>{ const f=e.target.files[0]; if(f) handleDocFile(f); e.target.value=""; };

// file text shares the OCR result card
function setStagedText(text, label){
  const t = (text||"").replace(/[ \t]+\n/g,"\n").replace(/\n{3,}/g,"\n\n").trim();
  $("ocrText").value = t;
  $("ocrConf").textContent = label || "";
  $("ocrResultCard").style.display = t ? "block" : "none";
  $("wordChips").innerHTML = "";
  $("ocrAddWords").style.display = "none";
  if(t) $("ocrResultCard").scrollIntoView({block:"nearest"});
}

function lazyScript(src){
  return new Promise((res, rej)=>{
    const s = document.createElement("script");
    s.src = src; s.onload = res;
    s.onerror = ()=>rej(new Error("Can't download the library — check connection and retry"));
    document.head.appendChild(s);
  });
}

let pdfJsLoading = null;
function loadPdfJs(){
  if(pdfJsLoading) return pdfJsLoading;
  pdfJsLoading = (async ()=>{
    if(!window["pdfjs-dist/build/pdf"])
      await lazyScript("https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js");
    const pdfjsLib = window["pdfjs-dist/build/pdf"];
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js";
    return pdfjsLib;
  })();
  return pdfJsLoading;
}

let mammothLoading = null;
function loadMammoth(){
  if(mammothLoading) return mammothLoading;
  mammothLoading = (async ()=>{
    if(!window.mammoth)
      await lazyScript("https://cdn.jsdelivr.net/npm/mammoth@1.9.1/mammoth.browser.min.js");
    return window.mammoth;
  })();
  return mammothLoading;
}

async function handleDocFile(file){
  const name = file.name.toLowerCase();
  $("docStatus").textContent = "Reading file…";
  $("docOcrBtn").style.display = "none";
  lastPdfBuffer = null;
  try{
    if(/\.(txt|text|md)$/.test(name)){
      const text = await file.text();
      setStagedText(text, `${file.name} · ${text.length.toLocaleString()} chars`);
    }else if(/\.docx$/.test(name)){
      const mammoth = await loadMammoth();
      const buf = await file.arrayBuffer();
      const { value } = await mammoth.extractRawText({arrayBuffer: buf});
      setStagedText(value, `${file.name} · ${value.length.toLocaleString()} chars`);
    }else if(/\.pdf$/.test(name)){
      const pdfjsLib = await loadPdfJs();
      const buf = await file.arrayBuffer();
      lastPdfBuffer = buf.slice(0);
      const pdf = await pdfjsLib.getDocument({data: buf}).promise;
      let text = "";
      for(let i=1;i<=pdf.numPages;i++){
        const page = await pdf.getPage(i);
        const tc = await page.getTextContent();
        text += tc.items.map(it=>it.str).join(" ") + "\n\n";
        $("docStatus").textContent = `Reading page ${i}/${pdf.numPages}…`;
      }
      text = text.replace(/ {2,}/g," ");
      if(text.trim().length < 50){
        setStagedText("", "");
        $("docOcrBtn").style.display = "inline-block";
        toast("This PDF has no text (scanned) — hit OCR to read it as images");
      }else{
        setStagedText(text, `${file.name} · ${pdf.numPages} pages · ${text.length.toLocaleString()} chars`);
      }
    }else{
      toast("Unsupported format: " + file.name);
    }
  }catch(e){
    toast("File read error: " + ((e&&e.message)||e));
  }finally{
    $("docStatus").textContent = "";
  }
}

// Scanned PDF: render each page to an image, then OCR (reuse the OCR pipeline)
$("docOcrBtn").onclick = async ()=>{
  if(!lastPdfBuffer) return;
  const btn = $("docOcrBtn"); btn.disabled = true;
  try{
    await loadTesseract();
    const pdfjsLib = await loadPdfJs();
    const pdf = await pdfjsLib.getDocument({data: lastPdfBuffer.slice(0)}).promise;
    const worker = await Tesseract.createWorker("eng", 1, {
      logger: m=>{
        if(m.status==="recognizing text")
          $("docStatus").textContent = "OCR… " + Math.round(m.progress*100) + "%";
      }
    });
    let full = "";
    for(let i=1;i<=pdf.numPages;i++){
      $("docStatus").textContent = `OCR page ${i}/${pdf.numPages}…`;
      const page = await pdf.getPage(i);
      const vp = page.getViewport({scale: 2.0});
      const c = document.createElement("canvas");
      c.width = Math.round(vp.width); c.height = Math.round(vp.height);
      await page.render({canvasContext: c.getContext("2d"), viewport: vp}).promise;
      const { data } = await worker.recognize(c);
      full += (data.text||"") + "\n\n";
    }
    await worker.terminate();
    setStagedText(full, `OCR ${pdf.numPages} pages · ${full.length.toLocaleString()} chars`);
    btn.style.display = "none";
  }catch(e){
    toast("PDF OCR error: " + ((e&&e.message)||e));
  }finally{
    btn.disabled = false;
    $("docStatus").textContent = "";
  }
};

/* ---------------- EN-EN DICTIONARY (dictionaryapi.dev, free, no key needed) ---------------- */
let dictCache = new Map();
try{ (store.get("dict", [])||[]).forEach(([w,v])=>dictCache.set(w,v)); }catch(e){}
function saveDictCache(){
  const arr = [...dictCache.entries()].slice(-300);
  dictCache = new Map(arr);
  try{ store.set("dict", arr); }catch(e){}
}
async function fetchDict(word){
  const w = word.trim().toLowerCase();
  if(!w) return null;
  if(dictCache.has(w)) return dictCache.get(w);
  const ctl = new AbortController();
  const timer = setTimeout(()=>ctl.abort(), 12000);
  try{
  const r = await fetch("https://api.dictionaryapi.dev/api/v2/entries/en/"+encodeURIComponent(w), {signal: ctl.signal});
  if(r.status===404){ const miss={miss:true}; dictCache.set(w,miss); saveDictCache(); return miss; }
  if(!r.ok) throw new Error("HTTP "+r.status);
  const j = await r.json();
  const e = j[0] || {};
  const ph = e.phonetics || [];
  const out = {
    word: e.word || w,
    phonetic: e.phonetic || (ph.map(p=>p.text).find(t=>t) || ""),
    audio: ph.map(p=>p.audio).find(a=>a) || "",
    meanings: (e.meanings||[]).slice(0,4).map(m=>({
      pos: m.partOfSpeech || "",
      defs: (m.definitions||[]).slice(0,4).map(d=>({d:d.definition||"", ex:d.example||""})),
      syn: (m.synonyms||[]).slice(0,8)
    }))
  };
  dictCache.set(w, out); saveDictCache();
  return out;
  }finally{ clearTimeout(timer); }
}
function renderDict(entry){
  const body = $("dictBody");
  if(!entry){ body.innerHTML = '<div class="hint">Type a word, then hit Look up.</div>'; return; }
  if(entry.miss){ body.innerHTML = '<div class="hint">No definition found for this word.</div>'; return; }
  let h = "";
  if(entry.phonetic) h += `<div style="color:var(--mut)">${esc(entry.phonetic)}${entry.audio?` <button class="iconbtn" id="dictAudio" title="Hear native pronunciation">🔊</button>`:""}</div>`;
  entry.meanings.forEach(m=>{
    if(m.pos) h += `<div class="dpos">${esc(m.pos)}</div>`;
    m.defs.forEach((d,i)=>{
      h += `<div class="ddef">${i+1}. ${esc(d.d)}</div>`;
      if(d.ex) h += `<div class="dex">"${esc(d.ex)}"</div>`;
    });
    if(m.syn && m.syn.length) h += `<div class="dsyn">≈ ${m.syn.map(s=>esc(s)).join(", ")}</div>`;
  });
  if(!h) h = '<div class="hint">No definition available.</div>';
  body.innerHTML = h;
  const ab = $("dictAudio");
  if(ab) ab.onclick = ()=>{ new Audio(entry.audio).play().catch(()=>toast("Can't play audio")); };
}
async function openDict(word){
  const w = (word||"").trim(); if(!w) return;
  $("dictTitle").textContent = w;
  $("dictBody").innerHTML = '<div class="hint">Looking up…</div>';
  $("dictModal").style.display = "flex";
  document.body.style.overflow = "hidden";
  try{ renderDict(await fetchDict(w)); }
  catch(e){
    const msg = (e && e.name==="AbortError")
      ? "Lookup timed out — check your connection and retry."
      : "Network error — check your connection and retry.";
    $("dictBody").innerHTML = '<div class="hint">'+msg+'</div>';
  }
}
function closeDict(){ $("dictModal").style.display = "none"; document.body.style.overflow = ""; }
$("dictBtn").onclick = ()=>openDict($("dictWord").value);
$("dictWord").addEventListener("keydown", e=>{ if(e.key==="Enter") openDict($("dictWord").value); });
$("dictClose").onclick = closeDict;
$("dictModal").onclick = e=>{ if(e.target===$("dictModal")) closeDict(); };

