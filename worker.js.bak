export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    // Force HTTPS: redirect plain-HTTP requests (fixes "not secure" warning in browsers)
    let _scheme = url.protocol;
    try { const _v = request.headers.get("CF-Visitor"); if (_v) _scheme = JSON.parse(_v).scheme + ":"; } catch (e) {}
    if (_scheme === "http:") { url.protocol = "https:"; return Response.redirect(url.toString(), 301); }
    if (url.pathname === "/api/tts" && request.method === "POST") return handleTTS(request, env);
    if (url.pathname === "/api/voices" && request.method === "GET") return handleVoices(env);
    if (url.pathname === "/api/quota" && request.method === "GET") return handleQuota(env);
    if (url.pathname === "/api/translate" && request.method === "POST") return handleTranslate(request, env);
    if (url.pathname === "/api/dict" && request.method === "GET") return handleDict(url, env);
    if (url.pathname === "/api/analytics" && request.method === "POST") return handleAnalytics(request, env);
    if (url.pathname === "/api/insights" && request.method === "GET") return handleInsights(url, env);
    if (url.pathname === "/api/auth/register" && request.method === "POST") return handleRegister(request, env);
    if (url.pathname === "/api/auth/send-code" && request.method === "POST") return handleSendCode(request, env);
    if (url.pathname === "/api/auth/verify-code" && request.method === "POST") return handleVerifyCode(request, env);
    if (url.pathname === "/api/auth/login" && request.method === "POST") return handleLogin(request, env);
    if (url.pathname === "/api/auth/logout" && request.method === "POST") return handleLogout(request, env);
    if (url.pathname === "/api/auth/me" && request.method === "GET") return handleMe(request, env);
    if (url.pathname === "/api/bank" && request.method === "GET") return handleBankGet(request, env);
    if (url.pathname === "/api/bank" && request.method === "POST") return handleBankPost(request, env);
    if (url.pathname === "/api/readings" && request.method === "GET") return handleReadingsList(request, env);
    if (url.pathname === "/api/readings" && request.method === "POST") return handleReadingsCreate(request, env);
    if (url.pathname.startsWith("/api/readings/") && request.method === "GET") return handleReadingGet(request, env);
    if (url.pathname.startsWith("/api/readings/") && request.method === "DELETE") return handleReadingDelete(request, env);
    if (url.pathname.startsWith("/api/readings/") && request.method === "PUT") return handleReadingAudioPut(request, env);
    if (url.pathname === "/api/admin/users" && request.method === "GET") return handleAdminUsers(request, env);
    if (url.pathname === "/api/admin/role" && request.method === "POST") return handleAdminRole(request, env);
    if (url.pathname.startsWith("/api/admin/users/") && request.method === "DELETE") return handleAdminDelete(request, env);
    if (url.pathname === "/api/books/upload" && request.method === "POST") return handleBookUpload(request, env);
    if (url.pathname === "/api/books" && request.method === "GET") return handleBookList(request, env);
    if (url.pathname.startsWith("/api/books/") && request.method === "GET") return handleBookGet(request, env);
    if (url.pathname === "/api/books/shared" && request.method === "GET") return handleBookShared(request, env);
    if (url.pathname === "/api/admin/books/pending" && request.method === "GET") return handleAdminBooksPending(request, env);
    if (url.pathname === "/api/admin/books/approve" && request.method === "POST") return handleAdminBooksApprove(request, env);
    if (url.pathname.startsWith("/stocks/api/")) return handleStocksProxy(request, env);
    if (url.pathname === "/api/books/result" && request.method === "POST") return handleBookResult(request, env);
    /* --- stock (chung khoan VN) --- */
    if (url.pathname === "/api/stock/indices" && request.method === "GET") return hStockIndices(request, env);
    if (url.pathname === "/api/stock/quote" && request.method === "GET") return hStockQuote(request, env);
    if (url.pathname === "/api/stock/ohlcv" && request.method === "GET") return hStockOhlcv(request, env);
    if (url.pathname === "/api/stock/symbols" && request.method === "GET") return hStockSymbols(request, env);
    if (url.pathname === "/api/stock/screener" && request.method === "GET") return hStockScreener(request, env);
    if (url.pathname === "/api/stock/screener2" && request.method === "GET") return hStockScreener2(request, env);
    if (url.pathname === "/api/stock/fundamentals" && request.method === "GET") return hStockFundamentals(request, env);
    if (url.pathname === "/api/stock/news" && request.method === "GET") return hStockNews(request, env);
    if (url.pathname === "/api/stock/events" && request.method === "GET") return hStockEvents(request, env);
    if (url.pathname === "/api/stock/backtest" && request.method === "GET") return hStockBacktest(request, env);
    if (url.pathname === "/api/stock/compare" && request.method === "GET") return hStockCompare(request, env);
    if (url.pathname === "/api/stock/watchlist" && request.method === "GET") return hWatchlistGet(request, env);
    if (url.pathname === "/api/stock/watchlist" && request.method === "POST") return hWatchlistAdd(request, env);
    if (url.pathname.startsWith("/api/stock/watchlist/") && request.method === "DELETE") return hWatchlistDel(request, env);
    if (url.pathname === "/api/stock/portfolio" && request.method === "GET") return hPortfolio(request, env);
    if (url.pathname === "/api/stock/portfolio/txn" && request.method === "POST") return hTxnAdd(request, env);
    if (url.pathname.startsWith("/api/stock/portfolio/txn/") && request.method === "DELETE") return hTxnDel(request, env);
    if (url.pathname.startsWith("/api/stock/portfolio/txn/") && request.method === "PUT") return hTxnNote(request, env);
    if (url.pathname === "/api/stock/portfolio/cost_history" && request.method === "GET") return hCostHistory(request, env);
    if (url.pathname === "/api/stock/alerts" && request.method === "GET") return hAlertsGet(request, env);
    if (url.pathname === "/api/stock/alerts" && request.method === "POST") return hAlertsAdd(request, env);
    if (url.pathname.startsWith("/api/stock/alerts/") && request.method === "DELETE") return hAlertsDel(request, env);
    if (url.pathname === "/api/stock/targets" && request.method === "GET") return hTargetsGet(request, env);
    if (url.pathname === "/api/stock/targets" && request.method === "POST") return hTargetsSet(request, env);
    if (url.pathname.startsWith("/api/stock/targets/") && request.method === "DELETE") return hTargetsDel(request, env);
    if (url.pathname === "/api/stock/pin/status" && request.method === "GET") return hPinStatus(request, env);
    if (url.pathname === "/api/stock/pin" && request.method === "POST") return hPinSet(request, env);
    if (url.pathname === "/api/stock/pin/verify" && request.method === "POST") return hPinVerify(request, env);
    if (url.pathname === "/api/stock/pin" && request.method === "DELETE") return hPinDel(request, env);
    if (url.pathname === "/api/internal/stock-publish" && request.method === "POST") return hStockPublish(request, env);
    if (url.pathname === "/api/internal/stock-report-data" && request.method === "GET") return hStockReportData(request, env);
    if (url.pathname === "/api/internal/stock-alert-done" && request.method === "POST") return hStockAlertDone(request, env);
    if (url.pathname === "/api/internal/stock-target-done" && request.method === "POST") return hStockTargetDone(request, env);
    return env.ASSETS.fetch(request);
  }
};
const rateMap = new Map();
function checkRate(ip) {
  const now = Date.now();
  let rec = rateMap.get(ip);
  if (!rec || now > rec.reset) rec = { count: 0, reset: now + 86400000 };
  rec.count++;
  rateMap.set(ip, rec);
  if (rateMap.size > 2000) for (const [k, v] of rateMap) if (now > v.reset) rateMap.delete(k);
  return rec.count <= 300;
}
function jerr(msg, status) {
  return new Response(JSON.stringify({ error: msg }), { status, headers: { "Content-Type": "application/json" } });
}
async function handleTTS(request, env) {
  const ip = request.headers.get("cf-connecting-ip") || "x";
  if (!checkRate(ip)) return jerr("Rate limit exceeded (300/day)", 429);
  const key = env.ELEVENLABS_API_KEY;
  if (!key) return jerr("TTS not configured", 503);
  let b;
  try { b = await request.json(); } catch (e) { return jerr("Invalid JSON", 400); }
  const text = (b.text || "").slice(0, 5000), voice_id = b.voice_id || "", model_id = b.model_id || "eleven_multilingual_v2";
  if (!text || !voice_id) return jerr("Missing text/voice_id", 400);
  const r = await fetch("https://api.elevenlabs.io/v1/text-to-speech/" + voice_id, {
    method: "POST",
    headers: { "xi-api-key": key, "Content-Type": "application/json" },
    body: JSON.stringify({ text, model_id })
  });
  if (!r.ok) return jerr("TTS provider error", r.status);
  const audio = await r.arrayBuffer();
  return new Response(audio, { headers: { "Content-Type": "audio/mpeg", "Cache-Control": "no-store" } });
}
async function handleVoices(env) {
  const key = env.ELEVENLABS_API_KEY;
  if (!key) return jerr("TTS not configured", 503);
  const r = await fetch("https://api.elevenlabs.io/v1/voices", { headers: { "xi-api-key": key } });
  if (!r.ok) return jerr("Voice list error", r.status);
  const j = await r.json();
  const voices = (j.voices || []).map(v => ({ voice_id: v.voice_id, name: v.name, labels: v.labels }));
  return new Response(JSON.stringify({ voices }), { headers: { "Content-Type": "application/json" } });
}
async function handleQuota(env) {
  const key = env.ELEVENLABS_API_KEY;
  if (!key) return jerr("TTS not configured", 503);
  const r = await fetch("https://api.elevenlabs.io/v1/user", { headers: { "xi-api-key": key } });
  if (!r.ok) return jerr("Quota error", r.status);
  const j = await r.json();
  return new Response(JSON.stringify({ subscription: j.subscription || {} }), { headers: { "Content-Type": "application/json" } });
}
/* ---------- translate proxy: same unofficial Google endpoint the app already
   used client-side, moved server-side so ad-blockers can't break the UI ---------- */
const translateCache = new Map(); // "target|text" -> {text, ts}
async function handleTranslate(request, env){
  const ip = request.headers.get("cf-connecting-ip") || "x";
  if(!checkRate(ip)) return jerr("Rate limit exceeded (300/day)", 429);
  let b;
  try{ b = await request.json(); }catch(e){ return jerr("Invalid JSON", 400); }
  const text = String(b.text||"").slice(0, 500).trim();
  const target = String(b.target||"vi").slice(0, 5);
  if(!text) return jerr("Empty text", 400);
  const ck = target+"|"+text;
  const c = translateCache.get(ck);
  if(c && Date.now()-c.ts < 86400000)
    return new Response(JSON.stringify({text:c.text}), {headers:{"Content-Type":"application/json"}});
  const url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl="
    + encodeURIComponent(target) + "&dt=t&q=" + encodeURIComponent(text);
  try{
    const r = await fetchTimeout(url, 8000, {headers:{"User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"}});
    if(!r.ok) return jerr("Translate upstream error", 502);
    const j = await r.json();
    const t = (j[0] && j[0][0] && j[0][0][0] || "").trim();
    translateCache.set(ck, {text:t, ts:Date.now()});
    if(translateCache.size > 2000){ const k = translateCache.keys().next().value; translateCache.delete(k); }
    return new Response(JSON.stringify({text:t}), {headers:{"Content-Type":"application/json"}});
  }catch(e){ return jerr("Translate failed", 502); }
}
/* ---------- fullstack dictionary: multi-source with fallback ---------- */
const dictCache = new Map(); // word -> {data, ts}
function fetchTimeout(url, ms, opts={}){
  const ctl = new AbortController();
  const t = setTimeout(()=>ctl.abort(), ms);
  return fetch(url, {...opts, signal: ctl.signal}).finally(()=>clearTimeout(t));
}
function stripHtml(s){
  return (s||"").replace(/<[^>]*>/g,"").replace(/&amp;/g,"&").replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&quot;/g,'"').replace(/&#39;/g,"'").trim();
}
async function handleDict(url, env){
  const word = (url.searchParams.get("word")||"").trim().toLowerCase();
  if(!word || !/^[a-z'-]{1,40}$/.test(word)) return jerr("Invalid word", 400);
  const cached = dictCache.get(word);
  if(cached && Date.now() - cached.ts < 86400000) {
    return new Response(JSON.stringify(cached.data), { headers: { "Content-Type": "application/json", "X-Cache": "hit" } });
  }
  // Multi-source aggregator (2026-10-05): race ALL sources in parallel, merge results.
  // Free (no key): Wiktionary, wiktapi.dev EN, wiktapi.dev VI
  // Key-based (env.MW_KEY, env.WORDSAPI_KEY): Merriam-Webster, WordsAPI - skipped if no key
  const UA = { "User-Agent": "EnglishLab/1.0 (https://lethanhdong.one)" };
  const results = await Promise.allSettled([
    // 1. Wiktionary (free)
    (async ()=>{
      const r = await fetchTimeout("https://en.wiktionary.org/api/rest_v1/page/definition/"+encodeURIComponent(word), 6000, {headers: UA});
      if(!r.ok) throw new Error("wikt "+r.status);
      return {src:"wiktionary", data: await r.json()};
    })(),
    // 2. wiktapi.dev EN (free)
    (async ()=>{
      const r = await fetchTimeout("https://api.wiktapi.dev/v1/en/word/"+encodeURIComponent(word)+"/definitions?lang=en", 6000, {headers: UA});
      if(!r.ok) throw new Error("wiktapi "+r.status);
      return {src:"wiktapi", data: await r.json()};
    })(),
    // 3. wiktapi.dev VI definitions (free)
    (async ()=>{
      const r = await fetchTimeout("https://api.wiktapi.dev/v1/vi/word/"+encodeURIComponent(word)+"/definitions?lang=en", 6000, {headers: UA});
      if(!r.ok) throw new Error("wiktapi-vi "+r.status);
      return {src:"wiktapi-vi", data: await r.json()};
    })(),
    // 4. Merriam-Webster Learner's Dictionary (env.MW_KEY)
    (async ()=>{
      if(!env.MW_KEY) throw new Error("no mw key");
      const r = await fetchTimeout("https://www.dictionaryapi.com/api/v3/references/learners/json/"+encodeURIComponent(word)+"?key="+env.MW_KEY, 6000, {headers: UA});
      if(!r.ok) throw new Error("mw "+r.status);
      return {src:"mw", data: await r.json()};
    })(),
    // 4b. Merriam-Webster Intermediate Thesaurus (env.MW_THES_KEY) - synonyms/antonyms
    (async ()=>{
      if(!env.MW_THES_KEY) throw new Error("no mw thes key");
      const r = await fetchTimeout("https://www.dictionaryapi.com/api/v3/references/ithesaurus/json/"+encodeURIComponent(word)+"?key="+env.MW_THES_KEY, 6000, {headers: UA});
      if(!r.ok) throw new Error("mw-thes "+r.status);
      return {src:"mw-thes", data: await r.json()};
    })(),
    // 5. WordsAPI via RapidAPI (needs env.WORDSAPI_KEY)
    (async ()=>{
      if(!env.WORDSAPI_KEY) throw new Error("no wordsapi key");
      const r = await fetchTimeout("https://wordsapiv1.p.rapidapi.com/words/"+encodeURIComponent(word), 6000, {
        headers: {"X-RapidAPI-Key": env.WORDSAPI_KEY, "X-RapidAPI-Host": "wordsapiv1.p.rapidapi.com", ...UA}
      });
      if(!r.ok) throw new Error("wordsapi "+r.status);
      return {src:"wordsapi", data: await r.json()};
    })(),
  ]);
  const ok = results.filter(x=>x.status==="fulfilled").map(x=>x.value);

  let out = { word, phonetic:"", audio:"", meanings:[], sources:[] };
  const seenDefs = new Set();
  const addMeaning = (pos, d, exs)=>{
    const txt = String(d||"").replace(/\s+/g," ").trim().slice(0,300);
    if(!txt || txt.length<3) return;
    const key = txt.toLowerCase().slice(0,60);
    if(seenDefs.has(key)) return;
    seenDefs.add(key);
    let m = out.meanings.find(m=>m.pos===(pos||""));
    if(!m){ m = {pos: pos||"", defs:[]}; out.meanings.push(m); }
    if(m.defs.length<4) m.defs.push({d: txt, exs: (exs||[]).map(e=>({t:String(e).slice(0,200)})).slice(0,2)});
  };
  function mwAudioUrl(file){
    if(!file) return "";
    const sub = file.slice(0,3)==="bix" ? "bix" : file.slice(0,2)==="gg" ? "gg" : /^[a-z]/i.test(file[0]||"") ? file[0].toLowerCase() : "number";
    return "https://media.merriam-webster.com/audio/prons/en/us/mp3/"+sub+"/"+file+".mp3";
  }
  // Parse in quality order: MW > wiktapi > wiktionary > wordsapi
  const bySrc = s => ok.find(x=>x.src===s);
  const mw = bySrc("mw"), wikt = bySrc("wiktapi"), wik = bySrc("wiktionary"), wapi = bySrc("wordsapi"), wvi = bySrc("wiktapi-vi");
  if(mw){
    out.sources.push("merriam-webster");
    try{
      for(const e of (mw.data||[]).slice(0,4)){
        if(typeof e !== "object" || !e) continue;
        const pos = e.fl || "";
        const prs0 = e.hwi && e.hwi.prs && e.hwi.prs[0];
        if(!out.phonetic && prs0 && (prs0.ipa || prs0.mw)) out.phonetic = prs0.ipa || prs0.mw;
        if(!out.audio && prs0 && prs0.sound && prs0.sound.audio) out.audio = mwAudioUrl(prs0.sound.audio);
        for(const sd of (e.shortdef||[]).slice(0,4)) addMeaning(pos, sd, []);
      }
    }catch(e){}
  }
  const mthes = bySrc("mw-thes");
  if(mthes){
    out.sources.push("mw-thesaurus");
    // collect {wd} words under a given list key (syn_list / ant_list) anywhere in sseq
    const collectWds = (node, key, arr)=>{
      if(!node) return;
      if(Array.isArray(node)){ node.forEach(n=>collectWds(n,key,arr)); return; }
      if(typeof node !== "object") return;
      if(node[key] && Array.isArray(node[key])){
        const pull = x=>{
          if(Array.isArray(x)){ x.forEach(pull); return; }
          if(x && typeof x.wd === "string"){
            const c = x.wd.replace(/\*/g,"").trim();
            if(c && !arr.includes(c)) arr.push(c);
          }
        };
        node[key].forEach(pull);
        return;
      }
      Object.values(node).forEach(v=>collectWds(v,key,arr));
    };
    try{
      for(const e of (mthes.data||[]).slice(0,2)){
        if(typeof e !== "object" || !e) continue;
        const syns = [], ants = [];
        (e.def||[]).forEach(d=>{
          collectWds(d.sseq, "syn_list", syns);
          collectWds(d.sseq, "ant_list", ants);
        });
        if(syns.length || ants.length){
          if(!out.thesaurus) out.thesaurus = [];
          out.thesaurus.push({syn: syns.slice(0,10), ant: ants.slice(0,10)});
        }
        // thesaurus shortdef can also add meanings
        for(const sd of (e.shortdef||[]).slice(0,2)) addMeaning(e.fl||"", sd, []);
      }
    }catch(e){}
  }
  if(wikt){
    out.sources.push("wiktapi");
    try{
      for(const d of (wikt.data.definitions||[]).slice(0,4)){
        for(const s of (d.senses||[]).slice(0,3)){
          const exs = (s.examples||[]).map(x=>x.text).filter(Boolean).slice(0,2);
          for(const g of (s.glosses||[]).slice(0,2))
            addMeaning(d.pos||"", g, exs);
        }
      }
    }catch(e){}
  }
  if(wik){
    out.sources.push("wiktionary");
    try{
      for(const e of (wik.data.en||[]).slice(0,4)){
        for(const d of (e.definitions||[]).slice(0,3)){
          const txt = stripHtml(d.definition||"");
          if(txt) addMeaning(e.partOfSpeech||"", txt, []);
        }
      }
    }catch(e){}
  }
  if(wapi){
    out.sources.push("wordsapi");
    try{
      const d = wapi.data||{};
      if(!out.phonetic && d.pronunciation){
        out.phonetic = typeof d.pronunciation === "string" ? d.pronunciation : (d.pronunciation.all||"");
      }
      for(const r of (d.results||[]).slice(0,4)){
        addMeaning(r.partOfSpeech||"", r.definition||"", (r.examples||[]).slice(0,2));
        // synonyms as extra value
        if(r.synonyms && r.synonyms.length && out.meanings.length){
          const m0 = out.meanings[0];
          if(!m0.syn) m0.syn = [...new Set(r.synonyms)].slice(0,6);
        }
      }
    }catch(e){}
  }
  // VI definitions from wiktapi-vi
  let viDefs = [];
  if(wvi){
    try{
      (wvi.data.definitions||[]).forEach(d=>{
        (d.senses||[]).forEach(s=>{
          (s.glosses||[]).slice(0,2).forEach(g=>{
            if(g && viDefs.length<4) viDefs.push({pos: d.pos||"", d: String(g).slice(0,200)});
          });
        });
      });
    }catch(e){}
  }
  if(!out.meanings.length) return jerr("Not found", 404);
  if(viDefs.length) out.viMeanings = viDefs;
  dictCache.set(word, {data: out, ts: Date.now()});
  if(dictCache.size > 2000){ const k = dictCache.keys().next().value; dictCache.delete(k); }
  return new Response(JSON.stringify(out), { headers: { "Content-Type": "application/json", "X-Cache": "miss" } });
}
/* ---------- server auth + RBAC (R2-backed) ---------- */
// Account DB (separate R2 bucket "english-lab-auth", binding AUTHDB):
//   users/{email}.json {email, salt, hash, role, created}
//   sessions/{token}.json {email, exp}
//   bank/{email}.json (encrypted blob, server can't read)
// Content DB (bucket "english-lab-data", binding DATA): books, uploads, jobs, analytics
const te = new TextEncoder();
async function pbkdf2Hash(password, saltB64){
  const salt = Uint8Array.from(atob(saltB64), c=>c.charCodeAt(0));
  const km = await crypto.subtle.importKey("raw", te.encode(password), "PBKDF2", false, ["deriveBits"]);
  const bits = await crypto.subtle.deriveBits({name:"PBKDF2", salt, iterations:100000, hash:"SHA-256"}, km, 256);
  return btoa(String.fromCharCode(...new Uint8Array(bits)));
}
function randToken(n=32){
  const b = crypto.getRandomValues(new Uint8Array(n));
  return [...b].map(x=>x.toString(16).padStart(2,"0")).join("");
}
async function getSession(request, env){
  const auth = request.headers.get("Authorization") || "";
  const m = auth.match(/^Bearer (.+)$/);
  if(!m) return null;
  try{
    const obj = await env.AUTHDB.get("sessions/"+m[1]+".json");
    if(!obj) return null;
    const s = await obj.json();
    if(s.exp < Date.now()){ await env.AUTHDB.delete("sessions/"+m[1]+".json"); return null; }
    return s; // {email, exp, token}
  }catch(e){ return null; }
}
async function getUser(env, email){
  try{
    const obj = await env.AUTHDB.get("users/"+String(email).toLowerCase()+".json");
    return obj ? await obj.json() : null;
  }catch(e){ return null; }
}
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
async function handleSendCode(request, env){
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const email = String(d.email||"").trim().toLowerCase();
  // Only Gmail allowed
  if(!/^[a-zA-Z0-9._%+-]+@gmail\.com$/.test(email)) return jerr("Only Gmail addresses allowed", 400);
  // Check if already registered
  const existing = await getUser(env, email);
  if(existing) return jerr("Email already registered", 400);
  // Generate 6-digit code
  const code = String(Math.floor(100000 + Math.random()*900000));
  const exp = Date.now() + 10*60*1000; // 10 minutes
  await env.AUTHDB.put(`verify/${email}.json`, JSON.stringify({code, exp, attempts: 0}), {
    httpMetadata: {contentType: "application/json"}
  });
  // Send via Resend (API key in env.RESEND_API_KEY)
  if(env.RESEND_API_KEY){
    try{
      await fetch("https://api.resend.com/emails", {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${env.RESEND_API_KEY}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          from: "Pocket Personal <noreply@lethanhdong.one>",
          to: email,
          subject: "Your verification code",
          html: `<p>Your verification code is:</p><h1 style="font-size:32px;letter-spacing:8px">${code}</h1><p>Valid for 10 minutes.</p>`
        })
      });
    }catch(e){
      console.error("Email send failed:", e);
      // Don't fail the request, code is stored - user can try resend
    }
  }
  return new Response(JSON.stringify({ok:true, sent: !!env.RESEND_API_KEY}), {headers:{"Content-Type":"application/json"}});
}
async function handleVerifyCode(request, env){
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const email = String(d.email||"").trim().toLowerCase();
  const code = String(d.code||"").trim();
  const obj = await env.AUTHDB.get(`verify/${email}.json`);
  if(!obj) return jerr("No code sent. Request a new one.", 400);
  const v = await obj.json();
  if(Date.now() > v.exp){
    await env.AUTHDB.delete(`verify/${email}.json`);
    return jerr("Code expired. Request a new one.", 400);
  }
  if(v.attempts >= 5){
    await env.AUTHDB.delete(`verify/${email}.json`);
    return jerr("Too many attempts. Request a new one.", 400);
  }
  if(v.code !== code){
    v.attempts++;
    await env.AUTHDB.put(`verify/${email}.json`, JSON.stringify(v), {httpMetadata:{contentType:"application/json"}});
    return jerr("Invalid code", 400);
  }
  // Code valid - mark verified (delete the code, create verified marker)
  await env.AUTHDB.delete(`verify/${email}.json`);
  await env.AUTHDB.put(`verified/${email}.json`, JSON.stringify({email, ts: Date.now()}), {
    httpMetadata: {contentType: "application/json"}
  });
  return new Response(JSON.stringify({ok:true}), {headers:{"Content-Type":"application/json"}});
}
async function handleRegister(request, env){
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const email = String(d.email||"").trim().toLowerCase().slice(0,80);
  const pw = String(d.password||"");
  const dob = String(d.dob||""); // YYYY-MM-DD
  if(!EMAIL_RE.test(email)) return jerr("Enter a valid email address", 400);
  if(pw.length < 4) return jerr("Password min 4 chars", 400);
  // Validate DOB and calculate age group
  let ageGroup = "adult";
  if(dob){
    const m = dob.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if(!m) return jerr("Invalid birth date", 400);
    const birth = new Date(+m[1], +m[2]-1, +m[3]);
    if(isNaN(birth.getTime()) || birth > new Date()) return jerr("Invalid birth date", 400);
    const age = Math.floor((Date.now() - birth.getTime()) / 31557600000);
    if(age < 0 || age > 120) return jerr("Invalid birth date", 400);
    ageGroup = age < 18 ? "kid" : "adult";
  }
  if(await getUser(env, email)) return jerr("Email already registered", 409);
  // First user becomes admin
  const list = await env.AUTHDB.list({prefix:"users/"});
  const role = list.objects.length === 0 ? "admin" : "user";
  const salt = btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(16))));
  const hash = await pbkdf2Hash(pw, salt);
  await env.AUTHDB.put("users/"+email+".json", JSON.stringify({
    email, salt, hash, role, dob: dob||null, ageGroup, created: Date.now()
  }), {httpMetadata:{contentType:"application/json"}});
  return new Response(JSON.stringify({ok:true, role, ageGroup, email}), {headers:{"Content-Type":"application/json"}});
}
async function handleLogin(request, env){
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const email = String(d.email||"").trim().toLowerCase();
  const u = await getUser(env, email);
  if(!u) return jerr("Invalid credentials", 401);
  const hash = await pbkdf2Hash(String(d.password||""), u.salt);
  if(hash !== u.hash) return jerr("Invalid credentials", 401);
  const token = randToken();
  await env.AUTHDB.put("sessions/"+token+".json", JSON.stringify({
    email: u.email, exp: Date.now()+30*86400000, token
  }), {httpMetadata:{contentType:"application/json"}});
  return new Response(JSON.stringify({token, email: u.email, role: u.role, ageGroup: u.ageGroup||"adult"}), {headers:{"Content-Type":"application/json"}});
}
async function handleLogout(request, env){
  const s = await getSession(request, env);
  if(s) await env.AUTHDB.delete("sessions/"+s.token+".json");
  return new Response(JSON.stringify({ok:true}), {headers:{"Content-Type":"application/json"}});
}
/* ---------- book upload + processing pipeline ---------- */
// Flow: POST /api/books/upload (PDF) -> R2 uploads/{user}/{id}.pdf
//   VM cron processes -> R2 books/{user}/{id}.json {title, chapters:[{title, sentences, cefr}]}
//   Vocab/stats auto-merged into shared corpus (no opt-in per owner decision)
async function handleBookUpload(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const ct = request.headers.get("content-type") || "";
  const isPdf = ct.includes("application/pdf");
  const isEpub = ct.includes("application/epub") || ct.includes("application/epub+zip");
  if(!isPdf && !isEpub) return jerr("PDF or EPUB only", 400);
  const buf = await request.arrayBuffer();
  if(buf.byteLength > 50*1024*1024) return jerr("Max 50MB", 413);
  if(buf.byteLength < 100) return jerr("Empty file", 400);
  const bookId = randToken(16);
  const title = (request.headers.get("x-book-title") || "Untitled").slice(0,100);
  const ext = isEpub ? "epub" : "pdf";
  const mime = isEpub ? "application/epub+zip" : "application/pdf";
  const key = `uploads/${s.email}/${bookId}.${ext}`;
  await env.DATA.put(key, buf, {
    httpMetadata: {contentType: mime},
    customMetadata: {title, uploader: s.email, ts: String(Date.now())},
  });
  // Create job marker
  await env.DATA.put(`jobs/${bookId}.json`, JSON.stringify({
    bookId, user: s.email, title, status: "pending", ts: Date.now()
  }), {httpMetadata:{contentType:"application/json"}});
  return new Response(JSON.stringify({ok:true, bookId, title}), {headers:{"Content-Type":"application/json"}});
}
async function handleBookList(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const list = await env.DATA.list({prefix: `books/${s.email}/`});
  const books = [];
  for(const o of list.objects){
    if(!o.key.endsWith(".json")) continue;
    try{
      const obj = await env.DATA.get(o.key);
      const b = await obj.json();
      books.push({id: o.key.split("/").pop().replace(".json",""), title: b.title, chapters: b.chapters.length, ts: b.ts, status: b.status});
    }catch(e){}
  }
  // Also include pending uploads
  const jobs = await env.DATA.list({prefix: "jobs/"});
  for(const o of jobs.objects){
    try{
      const obj = await env.DATA.get(o.key);
      const j = await obj.json();
      if(j.user === s.email && j.status === "pending"){
        books.push({id: j.bookId, title: j.title, chapters: 0, ts: j.ts, status: "processing"});
      }
    }catch(e){}
  }
  books.sort((a,b)=>b.ts-a.ts);
  return new Response(JSON.stringify({books}), {headers:{"Content-Type":"application/json"}});
}
async function handleBookGet(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const id = request.url.split("/").pop().split("?")[0];
  if(!/^[a-f0-9]{32}$/.test(id)) return jerr("Invalid id", 400);
  try{
    const obj = await env.DATA.get(`books/${s.email}/${id}.json`);
    if(!obj) return jerr("Not found", 404);
    return new Response(await obj.text(), {headers:{"Content-Type":"application/json"}});
  }catch(e){ return jerr("Read error", 500); }
}
async function handleBookShared(request, env){
  // Shared library: books admin has published
  const list = await env.DATA.list({prefix: "shared/"});
  const books = [];
  for(const o of list.objects){
    if(!o.key.endsWith(".json")) continue;
    try{
      const obj = await env.DATA.get(o.key);
      const b = await obj.json();
      books.push({id: o.key.split("/").pop().replace(".json",""), title: b.title, chapters: b.chapters.length, ts: b.ts});
    }catch(e){}
  }
  return new Response(JSON.stringify({books}), {headers:{"Content-Type":"application/json"}});
}
async function handleAdminBooksPending(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const u = await getUser(env, s.email);
  if(!u || u.role !== "admin") return jerr("Admin only", 403);
  // List all processed books (not yet in shared/)
  const shared = await env.DATA.list({prefix: "shared/"});
  const sharedIds = new Set(shared.objects.map(o=>o.key.split("/").pop().replace(".json","")));
  const books = [];
  // List from all users' books
  const all = await env.DATA.list({prefix: "books/"});
  for(const o of all.objects){
    if(!o.key.endsWith(".json")) continue;
    const id = o.key.split("/").pop().replace(".json","");
    if(sharedIds.has(id)) continue;
    try{
      const obj = await env.DATA.get(o.key);
      const b = await obj.json();
      const user = o.key.split("/")[1];
      books.push({id, title: b.title, user, chapters: b.chapters.length, ts: b.ts});
    }catch(e){}
  }
  return new Response(JSON.stringify({books}), {headers:{"Content-Type":"application/json"}});
}
async function handleAdminBooksApprove(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const u = await getUser(env, s.email);
  if(!u || u.role !== "admin") return jerr("Admin only", 403);
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const {bookId, user} = d;
  if(!bookId || !user) return jerr("Missing bookId/user", 400);
  const srcKey = `books/${user}/${bookId}.json`;
  const obj = await env.DATA.get(srcKey);
  if(!obj) return jerr("Book not found", 404);
  const data = await obj.arrayBuffer();
  await env.DATA.put(`shared/${bookId}.json`, data, {
    httpMetadata: {contentType: "application/json"},
    customMetadata: {title: d.title||"Untitled", approvedBy: s.email, ts: String(Date.now())},
  });
  return new Response(JSON.stringify({ok:true}), {headers:{"Content-Type":"application/json"}});
}
async function handleStocksProxy(request, env){
  // Proxy Stock App API calls to VM backend (via tunnel)
  // Backend URL configured via STOCKAPP_BACKEND env var
  const backend = env.STOCKAPP_BACKEND || "http://localhost:8903";
  const path = new URL(request.url).pathname.replace("/stocks/api", "/api");
  const target = backend + path + new URL(request.url).search;
  try{
    const resp = await fetch(target, {
      method: request.method,
      headers: request.headers,
      body: request.method !== "GET" && request.method !== "HEAD" ? await request.arrayBuffer() : null,
    });
    return new Response(resp.body, {status: resp.status, headers: resp.headers});
  }catch(e){
    return new Response(JSON.stringify({error: "Backend unavailable", detail: "Stock App backend not reachable. Tunnel may be down."}), 
      {status: 502, headers: {"Content-Type": "application/json"}});
  }
}
async function handleBookResult(request, env){
  // VM processor posts results here (protected by secret)
  const secret = request.headers.get("x-processor-secret");
  if(secret !== env.PROCESSOR_SECRET) return jerr("Forbidden", 403);
  let d; try{ d = await request.json(); }catch(e){ return jerr("Bad JSON", 400); }
  const {bookId, user, book} = d;
  if(!bookId || !user || !book) return jerr("Missing fields", 400);
  await env.DATA.put(`books/${user}/${bookId}.json`, JSON.stringify(book), {
    httpMetadata: {contentType: "application/json"}
  });
  await env.DATA.put(`jobs/${bookId}.json`, JSON.stringify({bookId, user, status: "done", ts: Date.now()}), {
    httpMetadata: {contentType: "application/json"}
  });
  // Auto-merge vocab into shared corpus (per owner: no opt-in)
  try{
    const corpus = await loadCorpus(env);
    const words = d.words || {};
    for(const w in words){
      if(/^[a-z'-]{2,30}$/.test(w)) corpus.wordFreq[w] = (corpus.wordFreq[w]||0) + Math.min(100, words[w]|0);
    }
    corpus.scans++;
    await saveCorpus(env, corpus);
  }catch(e){}
  return new Response(JSON.stringify({ok:true}), {headers:{"Content-Type":"application/json"}});
}
async function handleMe(request, env){
  const s = await getSession(request, env);
  if(!s) return jerr("Not logged in", 401);
  const u = await getUser(env, s.email);
  return new Response(JSON.stringify({email: u.email, role: u.role, ageGroup: u.ageGroup||"adult"}), {headers:{"Content-Type":"application/json"}});
}
async function requireAdmin(request, env){
  const s = await getSession(request, env);
  if(!s) return {err: jerr("Not logged in", 401)};
  const u = await getUser(env, s.email);
  if(!u || u.role !== "admin") return {err: jerr("Admin only", 403)};
  return {user: u, session: s};
}
