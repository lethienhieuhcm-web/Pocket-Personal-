<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml — plan "dac" D2: danh sách nhạc + phát
     1.3: form đăng nhập đã chuyển sang activity_auth.xml (AuthActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Trạng thái USB DAC -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAC Player"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Version (để user biết đang dùng bản nào) -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Danh sách nhạc từ R2 (MainActivity chỉ chạy khi đã đăng nhập) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Điều khiển phát -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/pickButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="File local" />

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phát / Dừng" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đăng xuất" />
    </LinearLayout>

    <!-- 1.5: Giấy phép mã nguồn mở (nghĩa vụ LGPL — FFmpeg) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/licensesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giấy phép mã nguồn mở" />
    </LinearLayout>
</LinearLayout>
